+[project]
+name = "comp-lens"
+version = "1.2.0"
+description = "Comp-Lens 2.0 — Compliance as Code."
+requires-python = ">=3.11"
+
+[tool.ruff]
+target-version = "py311"
+line-length = 120
+extend-exclude = ["alembic/versions", "app/static"]
+
+[tool.ruff.lint]
+select = ["E", "F", "W"]
+ignore = [
+    "E402",  # late imports — intentional (circular-import avoidance)
+    "E701",  # multiple statements on one line (colon) — intentional dense style
+    "E702",  # multiple statements on one line (semicolon) — intentional dense style
+    "E501",  # long lines — long f-strings/URLs
+]
+
+[tool.ruff.lint.per-file-ignores]
+"app/models.py" = ["F401"]
+"app/__init__.py" = ["F401"]
+"tests/*" = ["F401", "F811"]
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+addopts = "-p no:randomly"
