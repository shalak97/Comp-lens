    "days_since_last_login": {
      "type": "int",
      "plane": "identity_access",
      "kind": "signal",
      "meaning": "Time since the identity last authenticated.",
      "absence": "unobserved",
      "emitted_by": [
        "entra_user",
        "iam_user"
      ],
      "unit": "days"
