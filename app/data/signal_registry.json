{
  "version": "signal-registry-v1",
  "_comment": "The vocabulary joining connectors to controls. See app/signals.py for what each field means and what is enforced.",
  "signals": {
    "access_key_count": {
      "type": "int",
      "plane": "identity_access",
      "kind": "signal",
      "meaning": "Number of active programmatic access keys on the identity.",
      "absence": "unobserved",
      "emitted_by": [
        "iam_user",
        "service_principal"
      ],
      "unit": "keys"
    },
    "access_logging_enabled": {
      "type": "bool",
      "plane": "data_protection",
      "kind": "signal",
      "meaning": "Server access logging is configured on the resource.",
      "absence": "unobserved",
      "emitted_by": [
        "gcs_bucket",
        "s3_bucket",
        "storage_account"
      ]
    },
    "asset": {
      "type": "string",
      "plane": "data_protection",
      "kind": "metadata",
      "meaning": "Identifier of the asset this telemetry describes.",
      "absence": "unobserved",
      "emitted_by": [
        "gcs_bucket",
        "s3_bucket",
        "snyk_project",
        "splunk_index",
        "storage_account",
        "tenable_asset",
        "wiz_cloud_resource"
      ]
    },
    "audit_logs_retained": {
      "type": "bool",
      "plane": "logging_monitoring",
      "kind": "signal",
      "meaning": "Audit logs are retained rather than discarded on rotation.",
      "absence": "unobserved",
      "emitted_by": [
        "splunk_index"
      ]
    },
    "auto_minor_version_upgrade": {
      "type": "bool",
      "plane": "data_protection",
      "kind": "signal",
      "meaning": "The engine applies minor version patches automatically.",
      "absence": "unobserved",
      "emitted_by": [
        "cloud_sql",
        "rds_instance",
        "sql_database"
      ]
    },
    "backup_retention_days": {
      "type": "int",
      "plane": "data_protection",
      "kind": "signal",
      "meaning": "Days of automated backups retained.",
      "absence": "unobserved",
      "emitted_by": [
        "cloud_sql",
        "rds_instance",
        "sql_database"
      ],
      "unit": "days"
    },
    "cloudwatch_logs_integrated": {
      "type": "bool",
      "plane": "logging_monitoring",
      "kind": "signal",
      "meaning": "Logs are shipped to a central log store, not only kept locally.",
      "absence": "unobserved",
      "emitted_by": [
        "cloudtrail",
        "project",
        "subscription"
      ]
    },
    "code_scanning_enabled": {
      "type": "bool",
      "plane": "vulnerability_threat",
      "kind": "signal",
      "meaning": "Static analysis runs on the repository's code.",
      "absence": "unobserved",
      "emitted_by": [
        "snyk_project"
      ]
    },
    "config_recording_enabled": {
      "type": "bool",
      "plane": "configuration",
      "kind": "signal",
      "meaning": "A configuration recorder is running for the account.",
      "absence": "unobserved",
      "emitted_by": [
        "config_recorder"
      ]
    },
    "config_records_all_resources": {
      "type": "bool",
      "plane": "configuration",
      "kind": "signal",
      "meaning": "The configuration recorder covers every supported resource type.",
      "absence": "unobserved",
      "emitted_by": [
        "config_recorder"
      ]
    },
    "console_access_enabled": {
      "type": "bool",
      "plane": "identity_access",
      "kind": "signal",
