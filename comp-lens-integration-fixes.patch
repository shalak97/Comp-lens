+# ─────────────────────────────────────────────────────────────────────────────
+# Connector INSTANCES — many configured connections per connector type.
+# Credentials come from the instance's own config (not global env). For the live
+# path we overlay that config onto the environment for the duration of the call,
+# so existing env/settings-reading collectors work per-instance. The demo path
+# works with zero credentials. Evidence is scoped to instance_id so instances of
+# the same type never overwrite each other.
+# ─────────────────────────────────────────────────────────────────────────────
+def _inst_env_state(c: Dict[str, Any], config: Dict[str, Any]) -> Dict[str, Any]:
+    names = c.get("env_vars", [])
+    set_names = [n for n in names if config.get(n)]
+    return {"required": names, "set": set_names,
+            "missing": [n for n in names if not config.get(n)],
+            "complete": bool(names) and len(set_names) == len(names)}
+
+
+@contextlib.contextmanager
+def _config_overlay(config: Dict[str, Any]):
+    """Temporarily expose an instance's config to live collectors — true per-instance
+    isolation. Connectors read credentials two ways, so we cover both:
+      1. os.environ, for anything reading env directly;
+      2. the cached Settings singleton — most connectors do ``settings.<field>``,
+         so we refresh the singleton's overlaid fields in place (and restore them),
+         which avoids editing every connector while giving real isolation.
+    Env-var names map to settings fields by lowercasing (AWS_REGION -> aws_region).
+    """
+    from app.config import settings as _live_settings
+    saved_env: Dict[str, Optional[str]] = {}
+    saved_attr: Dict[str, Any] = {}
+    try:
+        for k, v in (config or {}).items():
+            saved_env[k] = os.environ.get(k)
+            if v not in (None, ""):
+                os.environ[k] = str(v)
+        try:
+            get_settings.cache_clear()  # fresh get_settings() reads the overlay
+        except Exception:  # noqa: BLE001
+            pass
+        for k, v in (config or {}).items():
+            attr = k.lower()
+            if hasattr(_live_settings, attr):
+                saved_attr[attr] = getattr(_live_settings, attr)
+                try:
+                    object.__setattr__(_live_settings, attr, v)
+                except Exception:  # noqa: BLE001
+                    pass
+        yield
+    finally:
+        for k, old in saved_env.items():
+            if old is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = old
+        for attr, old in saved_attr.items():
+            try:
+                object.__setattr__(_live_settings, attr, old)
+            except Exception:  # noqa: BLE001
+                pass
+        try:
+            get_settings.cache_clear()
+        except Exception:  # noqa: BLE001
+            pass
+
+
+def instance_mode(c: Dict[str, Any], config: Dict[str, Any]) -> str:
+    """Display mode for an instance badge: connected | demo | not_configured."""
+    env = _inst_env_state(c, config)
+    if not env["complete"]:
+        return "not_configured" if env["required"] else "demo"
+    if not _safety.live_allowed(c["key"], c.get("auth_method"))["allowed"]:
+        return "demo"
+    return "connected"
+
+
+def test_instance(c: Dict[str, Any], config: Dict[str, Any]) -> Dict[str, Any]:
+    env = _inst_env_state(c, config)
+    if not env["complete"]:
+        miss = ", ".join(env["missing"][:4]) or "credentials"
+        return {"key": c["key"], "ok": True, "mode": "demo",
+                "detail": f"demo mode (set {miss} for live)"}
+    gate = _safety.live_allowed(c["key"], c.get("auth_method"))
+    if not gate["allowed"]:
+        return {"key": c["key"], "ok": True, "mode": "demo",
+                "detail": f"demo (guardrail: {gate['reason']})"}
+    with _config_overlay(config):
+        return test_connection(c)
+
+
+def sync_instance(db: Session, c: Dict[str, Any], instance_id: str,
+                  config: Dict[str, Any], tenant_id: str = "default",
+                  force_demo: bool = False) -> Dict[str, Any]:
+    mode, items, error = "demo", None, None
+    if not force_demo and _inst_env_state(c, config)["complete"]:
+        try:
+            with _config_overlay(config):
+                live = _try_live_collect(c)
+            if live is not None:
+                mode, items = "live", live
+        except Exception as exc:  # noqa: BLE001
+            error = f"live collection failed: {type(exc).__name__}"
+    if items is None:
+        items = demo_evidence(c)
+    norm = _normalize(c, items, mode)
+
+    # scope evidence to THIS instance (not the whole connector type)
+    db.execute(delete(ConnectorEvidenceItem).where(
+        ConnectorEvidenceItem.instance_id == instance_id))
+    for n in norm:
+        db.add(ConnectorEvidenceItem(
+            tenant_id=tenant_id, connector_key=c["key"], instance_id=instance_id,
+            category=n["category"], evidence_type=n["evidence_type"], title=n["title"],
+            status=n["status"], mode=n["mode"], signals=n["signals"], controls=n["controls"]))
+    db.commit()
+    return {"key": c["key"], "instance_id": instance_id, "mode": mode,
+            "evidence_count": len(norm),
+            "status": "ok" if not error else "degraded", "error": error}
+
+
+def evidence_for_instance(db: Session, instance_id: str,
+                          tenant_id: str = "default") -> List[Dict[str, Any]]:
+    rows = db.execute(select(ConnectorEvidenceItem).where(
+        ConnectorEvidenceItem.instance_id == instance_id,
+        ConnectorEvidenceItem.tenant_id == tenant_id).order_by(
+        ConnectorEvidenceItem.collected_at.desc())).scalars().all()
+    return [{"evidence_type": r.evidence_type, "title": r.title, "status": r.status,
+             "mode": r.mode, "signals": r.signals, "controls": r.controls,
+             "collected_at": r.collected_at.isoformat() if r.collected_at else None}
+            for r in rows]
+
+
+def aggregate_control_status(db: Session, tenant_id: str = "default") -> Dict[str, Dict[str, Any]]:
+    """Roll collected connector evidence up by control id.
+
+    Connectors already evaluate their telemetry into pass/fail per item; this
+    aggregates those across every instance so posture can reflect what was
+    actually observed. A control is FAIL if ANY covering item failed.
+    Returns {control_id: {status, fail, pass, items, sources[]}}.
+    """
+    rows = db.execute(select(ConnectorEvidenceItem).where(
+        ConnectorEvidenceItem.tenant_id == tenant_id)).scalars().all()
+    out: Dict[str, Dict[str, Any]] = {}
+    for r in rows:
+        for cd in (r.controls or []):
+            cid = cd.get("control_id") if isinstance(cd, dict) else cd
+            if not cid:
+                continue
+            agg = out.setdefault(cid, {"status": "pass", "fail": 0, "pass": 0,
+                                       "items": 0, "sources": set()})
+            agg["items"] += 1
+            agg["sources"].add(r.connector_key)
+            st = str(r.status).lower()
+            if st == "fail":
+                agg["fail"] += 1
+                agg["status"] = "fail"
+            elif st == "pass":
+                agg["pass"] += 1
+    for _cid, a in out.items():
+        a["sources"] = sorted(a["sources"])
+    return out
