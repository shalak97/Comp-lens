+# ── CONNECTOR EVIDENCE → POSTURE (findings) ──────────────────────────
+def assess_connector_evidence(db: Session, tenant_id: str) -> Dict[str, Any]:
+    """Project collected connector evidence into control posture findings.
+
+    This closes the loop the product promises: syncing a connector now actually
+    moves your posture. Connectors already evaluate telemetry into pass/fail per
+    item; we roll that up by control and persist one idempotent finding per
+    (control, connector-evidence) — so it flows into blast radius, remediation,
+    and the compliance score exactly like any other finding.
+    """
+    from app.connectors.framework import aggregate_control_status
+    status_by_control = aggregate_control_status(db, tenant_id)
+    run_id = "conn_" + uuid.uuid4().hex[:12]
+    created, updated, failing = 0, 0, []
+    for cid, agg in status_by_control.items():
+        cstatus = ControlStatus.FAIL if agg["status"] == "fail" else ControlStatus.PASS
+        sev = Severity.HIGH if cstatus == ControlStatus.FAIL else Severity.INFO
+        srcs = ", ".join(agg["sources"]) or "connectors"
+        reason = (f"{agg['fail']} of {agg['items']} evidence item(s) failing from {srcs}"
+                  if cstatus == ControlStatus.FAIL
+                  else f"{agg['items']} evidence item(s) passing from {srcs}")
+        if cstatus == ControlStatus.FAIL:
+            failing.append(cid)
+        # idempotent across re-runs: match ANY prior connector finding for this
+        # control (PASS findings are stored RESOLVED, so don't filter on lifecycle)
+        existing = db.execute(
+            select(Finding).where(Finding.tenant_id == tenant_id,
+                                  Finding.control_id == cid,
+                                  Finding.source_system == CONNECTOR_SOURCE)
+            .order_by(Finding.updated_at.desc())).scalars().first()
+        if existing:
+            existing.status = cstatus
+            existing.severity = sev
+            existing.description = reason
+            existing.remediation = {"sources": agg["sources"], "items": agg["items"]}
+            existing.updated_at = datetime.now(timezone.utc)
+            if cstatus == ControlStatus.PASS:
+                existing.lifecycle = Lifecycle.RESOLVED
+            updated += 1
+        else:
+            db.add(Finding(
+                finding_id=str(uuid.uuid4()), tenant_id=tenant_id, run_id=run_id,
+                framework="ALL", control_id=cid, source_system=CONNECTOR_SOURCE,
+                status=cstatus, severity=sev,
+                lifecycle=Lifecycle.OPEN if cstatus == ControlStatus.FAIL else Lifecycle.RESOLVED,
+                description=reason,
+                remediation={"sources": agg["sources"], "items": agg["items"]}))
+            created += 1
+    db.commit()
+    return {"run_id": run_id, "controls_assessed": len(status_by_control),
+            "findings_created": created, "findings_updated": updated,
+            "failing_controls": failing,
+            "note": "connector evidence is now reflected in findings + posture"}
+
+
