+@router.get("/enforcement/decisions")
+def decisions(limit: int = 100, tenant_id: str = "default", p: Principal = Depends(require_principal)):
+    authorize_tenant(p, tenant_id)
+    items = list(DECISIONS)[-limit:][::-1]
