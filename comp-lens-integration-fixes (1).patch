+@router.post("/enforcement/systems/{host}/mode")
+def set_mode(host: str, body: dict, tenant_id: str = "default", p: Principal = Depends(require_principal)):
+    authorize_tenant(p, tenant_id)
+    mode = (body or {}).get("mode")
+    if mode not in ("shadow", "enforce"):
+        raise HTTPException(400, "mode must be 'shadow' or 'enforce'")
+    path = POLICY_DIR / "data.json"
+    if not path.exists():
+        raise HTTPException(503, f"No policy data.json under {POLICY_DIR}.")
+    doc = json.loads(path.read_text())
+    if host not in doc.get("systems", {}):
+        raise HTTPException(404, f"unknown system '{host}'")
+    doc["systems"][host]["mode"] = mode
+    path.write_text(json.dumps(doc, indent=2) + "\n")
+    try:
+        from app.services import privacy as _pv
+        from app.database import SessionLocal
+        db = SessionLocal()
+        _pv.record_event(db, tenant_id, "enforcement.mode_changed", actor=getattr(p, "id", "system"),
+                         entity_type="enforcement_system", entity_id=host,
+                         summary=f"{host} → {mode}")
+        db.close()
+    except Exception:  # noqa: BLE001 — audit logging must never block the mode change
+        pass
+    return {"system": host, "mode": mode, "bundle_revision": bundle_revision()}
+
+
+@router.get("/healthz")
+def healthz():
+    ok = (POLICY_DIR / "main.rego").exists() and (POLICY_DIR / "data.json").exists()
+    return {"ok": ok, "revision": bundle_revision() if ok else None}
