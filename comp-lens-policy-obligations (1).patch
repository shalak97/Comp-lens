+@app.get("/policy/obligations", tags=["policy"])
+def list_obligations_ep(control_id: str | None = None, procedure: str | None = None,
+                        tenant_id: str = "default", db: Session = Depends(get_db),
+                        p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, tenant_id)
+    return {"procedures": _obl.PROCEDURES,
+            "dispatches": _obl.list_dispatches(db, tenant_id, control_id=control_id,
+                                               procedure=procedure)}
+
+
+@app.post("/policy/obligations/preview", tags=["policy"])
+def preview_obligations_ep(req: _ObligationPreviewReq, db: Session = Depends(get_db),
+                           p: Principal = Depends(require_principal)) -> dict:
+    """Dry-run: evaluate policies against supplied evidence and show which
+    operational procedures each failing rule WOULD disperse to — no side effects."""
+    authorize_tenant(p, req.tenant_id)
+    from app.policy_as_code import get_engine
+    decisions = get_engine().evaluate_all(req.evidence_by_control or {})
+    planned = []
+    for d in decisions:
+        if d.status == "fail" and getattr(d, "obligations", None):
+            planned += _obl.dispatch_for_decision(
+                db, req.tenant_id, d,
+                evidence=(req.evidence_by_control or {}).get(d.control_id, {}),
+                dry_run=True)
+    return {"evaluated": len(decisions),
+            "failing": [d.control_id for d in decisions if d.status == "fail"],
+            "planned_actions": planned}
+
