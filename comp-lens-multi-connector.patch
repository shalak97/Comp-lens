+"""Connector instances: multiple connections per type, per tenant.
+
+Asserts the capability the old env-var model could not provide — many instances
+of the same connector_key — plus credential encryption, per-instance evidence
+isolation, and tenant scoping.
+"""
+import os
+
+os.environ.setdefault("DATABASE_URL", "sqlite+pysqlite:////tmp/test_instances.db")
+os.environ.setdefault("APP_ENV", "development")
+os.environ.setdefault("COMP_LENS_SECRET_KEY", "unit-test-secret-key")
+
+import pytest
+from fastapi.testclient import TestClient
+
+
+@pytest.fixture()
+def client():
+    import app.main as M
+    from app.database import Base, engine
+    Base.metadata.create_all(bind=engine)
+    return TestClient(M.app)
+
+
+def _mk(client, key, label, cfg, tenant="default"):
+    r = client.post("/connectors/instances",
+                    json={"connector_key": key, "label": label, "config": cfg, "tenant_id": tenant})
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def test_multiple_instances_of_same_type_coexist(client):
+    a = _mk(client, "AWS_SECURITY_HUB", "AWS Prod",
+            {"AWS_ACCESS_KEY_ID": "AKIA1", "AWS_SECRET_ACCESS_KEY": "s1", "AWS_REGION": "us-east-1"})
+    b = _mk(client, "AWS_SECURITY_HUB", "AWS Staging",
+            {"AWS_ACCESS_KEY_ID": "AKIA2", "AWS_SECRET_ACCESS_KEY": "s2", "AWS_REGION": "eu-west-1"})
+    assert a["id"] != b["id"]
+    aws = client.get("/connectors/instances?connector_key=AWS_SECURITY_HUB").json()
+    assert len(aws) == 2  # the old (tenant,connector) model could only hold one
+
+
+def test_credentials_are_encrypted_and_never_returned(client):
+    inst = _mk(client, "OKTA", "Okta Corp",
+               {"OKTA_ORG_URL": "https://corp.okta.com", "OKTA_API_TOKEN": "supersecret"})
+    # response exposes only which keys are set, never the values
+    assert "config" not in inst
+    assert inst["config_keys_set"] == ["OKTA_API_TOKEN", "OKTA_ORG_URL"]
+    # stored ciphertext must not contain the plaintext secret
+    from app.database import SessionLocal
+    from app.models import ConnectorInstance
+    db = SessionLocal()
+    row = db.get(ConnectorInstance, inst["id"])
+    assert row.config_enc and "supersecret" not in row.config_enc
+    # but it decrypts back correctly for internal use
+    from app.services.secrets import decrypt_json
+    assert decrypt_json(row.config_enc)["OKTA_API_TOKEN"] == "supersecret"
+    db.close()
+
+
+def test_per_instance_sync_and_evidence_isolation(client):
+    a = _mk(client, "GITHUB", "GH OrgA", {"GITHUB_TOKEN": "t1", "GITHUB_ORG": "orgA"})
+    b = _mk(client, "GITHUB", "GH OrgB", {"GITHUB_TOKEN": "t2", "GITHUB_ORG": "orgB"})
+    ra = client.post(f"/connectors/instances/{a['id']}/sync", json={}).json()
+    rb = client.post(f"/connectors/instances/{b['id']}/sync", json={}).json()
+    assert ra["evidence_count"] > 0 and rb["evidence_count"] > 0
+    ea = client.get(f"/connectors/instances/{a['id']}/evidence").json()
+    eb = client.get(f"/connectors/instances/{b['id']}/evidence").json()
+    assert len(ea) == ra["evidence_count"] and len(eb) == rb["evidence_count"]
+    # re-syncing A must not change B's evidence count (isolated stores)
+    client.post(f"/connectors/instances/{a['id']}/sync", json={}).json()
+    assert len(client.get(f"/connectors/instances/{b['id']}/evidence").json()) == len(eb)
+    # sync status is recorded on the instance row
+    got = client.get(f"/connectors/instances/{a['id']}").json()
+    assert got["last_status"] == "ok" and got["evidence_count"] == len(ea)
+
+
+def test_tenant_isolation(client):
+    _mk(client, "JIRA", "Jira default", {"JIRA_URL": "u", "JIRA_EMAIL": "e", "JIRA_API_TOKEN": "t"})
+    _mk(client, "JIRA", "Jira acme", {"JIRA_URL": "u", "JIRA_EMAIL": "e", "JIRA_API_TOKEN": "t"}, tenant="acme")
+    d = client.get("/connectors/instances?tenant_id=default&connector_key=JIRA").json()
+    a = client.get("/connectors/instances?tenant_id=acme&connector_key=JIRA").json()
+    assert len(d) == 1 and len(a) == 1
+    # a default-tenant caller cannot fetch an acme instance by id
+    acme_id = a[0]["id"]
+    assert client.get(f"/connectors/instances/{acme_id}?tenant_id=default").status_code == 404
+
+
+def test_unknown_connector_type_rejected(client):
+    r = client.post("/connectors/instances", json={"connector_key": "NOT_A_REAL_THING", "config": {}})
+    assert r.status_code == 404
+
+
+def test_update_and_delete(client):
+    inst = _mk(client, "OKTA", "Okta X", {"OKTA_ORG_URL": "x", "OKTA_API_TOKEN": "y"})
+    up = client.patch(f"/connectors/instances/{inst['id']}", json={"label": "Okta Renamed"}).json()
+    assert up["label"] == "Okta Renamed"
+    assert client.delete(f"/connectors/instances/{inst['id']}").json()["deleted"] is True
+    assert client.get(f"/connectors/instances/{inst['id']}").status_code == 404
