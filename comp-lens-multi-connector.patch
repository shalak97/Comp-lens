@@ -0,0 +1,114 @@
+"""Service layer for connector instances (multi-app / multi-tenant connections).
+
+A connector *type* (catalog entry, e.g. AWS_SECURITY_HUB) can have many
+*instances* — one per account/org/tenant — each with its own label and
+encrypted credentials. Secrets are never returned to the client; the API only
+reveals which config keys are set.
+"""
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any, Dict, List, Optional
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.models import ConnectorInstance, utc_now
+from app.services.secrets import decrypt_json, encrypt_json
+
+
+def _serialize(inst: ConnectorInstance, config: Optional[dict] = None) -> Dict[str, Any]:
+    """Public shape — NEVER includes secret values, only which keys are set."""
+    cfg = config if config is not None else decrypt_json(inst.config_enc)
+    return {
+        "id": inst.id,
+        "tenant_id": inst.tenant_id,
+        "connector_key": inst.connector_key,
+        "label": inst.label,
+        "enabled": inst.enabled,
+        "config_keys_set": sorted(k for k, v in cfg.items() if v not in (None, "")),
+        "last_sync_at": inst.last_sync_at.isoformat() if inst.last_sync_at else None,
+        "last_status": inst.last_status,
+        "last_mode": inst.last_mode,
+        "evidence_count": inst.evidence_count,
+        "last_error": inst.last_error,
+        "created_at": inst.created_at.isoformat() if inst.created_at else None,
+        "updated_at": inst.updated_at.isoformat() if inst.updated_at else None,
+    }
+
+
+class ConnectorInstanceService:
+    def __init__(self, db: Session):
+        self.db = db
+
+    def list(self, tenant_id: str = "default",
+             connector_key: Optional[str] = None) -> List[Dict[str, Any]]:
+        q = select(ConnectorInstance).where(ConnectorInstance.tenant_id == tenant_id)
+        if connector_key:
+            q = q.where(ConnectorInstance.connector_key == connector_key)
+        rows = self.db.execute(q.order_by(ConnectorInstance.created_at)).scalars().all()
+        return [_serialize(r) for r in rows]
+
+    def get(self, instance_id: str, tenant_id: str = "default") -> Optional[ConnectorInstance]:
+        inst = self.db.get(ConnectorInstance, instance_id)
+        if inst and inst.tenant_id == tenant_id:
+            return inst
+        return None
+
+    def get_public(self, instance_id: str, tenant_id: str = "default") -> Optional[Dict[str, Any]]:
+        inst = self.get(instance_id, tenant_id)
+        return _serialize(inst) if inst else None
+
+    def config_of(self, inst: ConnectorInstance) -> dict:
+        return decrypt_json(inst.config_enc)
+
+    def create(self, tenant_id: str, connector_key: str, label: str,
+               config: Optional[dict] = None, enabled: bool = True) -> Dict[str, Any]:
+        inst = ConnectorInstance(
+            tenant_id=tenant_id,
+            connector_key=connector_key,
+            label=label or connector_key,
+            config_enc=encrypt_json(config or {}),
+            enabled=enabled,
+        )
+        self.db.add(inst)
+        self.db.commit()
+        self.db.refresh(inst)
+        return _serialize(inst, config or {})
+
+    def update(self, instance_id: str, tenant_id: str = "default", *,
+               label: Optional[str] = None, enabled: Optional[bool] = None,
+               config: Optional[dict] = None) -> Optional[Dict[str, Any]]:
+        inst = self.get(instance_id, tenant_id)
+        if not inst:
+            return None
+        if label is not None:
+            inst.label = label
+        if enabled is not None:
+            inst.enabled = enabled
+        if config is not None:
+            # merge: only overwrite provided keys; empty string clears a key
+            current = decrypt_json(inst.config_enc)
+            current.update(config)
+            inst.config_enc = encrypt_json({k: v for k, v in current.items() if v != ""})
+        inst.updated_at = utc_now()
+        self.db.commit()
+        self.db.refresh(inst)
+        return _serialize(inst)
+
+    def delete(self, instance_id: str, tenant_id: str = "default") -> bool:
+        inst = self.get(instance_id, tenant_id)
+        if not inst:
+            return False
+        self.db.delete(inst)
+        self.db.commit()
+        return True
+
+    def record_sync(self, inst: ConnectorInstance, *, status: str, mode: str,
+                    evidence_count: int, error: Optional[str] = None) -> None:
+        inst.last_sync_at = utc_now()
+        inst.last_status = status
+        inst.last_mode = mode
+        inst.evidence_count = evidence_count
+        inst.last_error = error
+        self.db.commit()
