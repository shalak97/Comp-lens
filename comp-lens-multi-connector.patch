+"""Encryption for connector credentials stored at rest.
+
+Connector instances keep their credentials in the database (so you can register
+many accounts without a redeploy). Those credentials are encrypted with Fernet
+(AES-128-CBC + HMAC) using a key derived from COMP_LENS_SECRET_KEY.
+
+Set COMP_LENS_SECRET_KEY in production (any high-entropy string). If it is unset,
+a deterministic *development* key is used and `secrets_configured()` returns
+False so the API can refuse to store live credentials in production.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import logging
+import os
+from typing import Any
+
+from cryptography.fernet import Fernet, InvalidToken
+
+logger = logging.getLogger("complens.secrets")
+
+_ENV = "COMP_LENS_SECRET_KEY"
+_DEV_FALLBACK = b"comp-lens-dev-insecure-key-do-not-use-in-prod"
+
+
+def secrets_configured() -> bool:
+    """True only when a real key is set (gate live-credential storage on this)."""
+    return bool(os.getenv(_ENV))
+
+
+def _fernet() -> Fernet:
+    raw = os.getenv(_ENV)
+    if not raw:
+        logger.warning("%s not set — using an insecure development key. "
+                       "Do NOT store real credentials until this is set.", _ENV)
+        material = _DEV_FALLBACK
+    else:
+        material = raw.encode("utf-8")
+    # sha256 -> 32 bytes -> urlsafe base64 = a valid Fernet key
+    key = base64.urlsafe_b64encode(hashlib.sha256(material).digest())
+    return Fernet(key)
+
+
+def encrypt_json(obj: Any) -> str:
+    """Encrypt a JSON-serializable object to a token string."""
+    token = _fernet().encrypt(json.dumps(obj, separators=(",", ":")).encode("utf-8"))
+    return token.decode("utf-8")
+
+
+def decrypt_json(token: str | None) -> dict:
+    """Decrypt a token back to a dict. Returns {} on missing/invalid input."""
+    if not token:
+        return {}
+    try:
+        return json.loads(_fernet().decrypt(token.encode("utf-8")).decode("utf-8"))
+    except (InvalidToken, ValueError, TypeError):
+        logger.error("could not decrypt connector config (wrong key or corrupt data)")
+        return {}
