# ─── Comp-Lens configuration ───
# Copy to .env and fill in only the connectors you use.
# NEVER commit a real .env to git.

# App
APP_ENV=local                     # local | staging | production
LOG_LEVEL=INFO
# Comma-separated; set to your frontend URL in production
CORS_ORIGINS=["*"]
# API auth: leave empty to disable. Tenant-scoped: key:tenantA,tenantB ; key2:*
# `*` = admin (all tenants). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# COMP_LENS_API_KEYS=
# Gate the synthetic DEMO connector (auto-off in production). Override here:
# ENABLE_DEMO_CONNECTOR=false
# Auto-create tables on boot (auto-off in production; use Alembic there):
# AUTO_CREATE_TABLES=false
# DB pool (PostgreSQL):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# External call retries:
# RETRY_ATTEMPTS=3

# Database
# Local default is SQLite. For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/complens
DATABASE_URL=sqlite:///./complens.db

# Evidence store
EVIDENCE_BACKEND=local            # local | s3
EVIDENCE_LOCAL_PATH=./evidence_store
# EVIDENCE_S3_BUCKET=my-complens-evidence
# EVIDENCE_S3_PREFIX=evidence/

# ─── AWS ───
# On EC2/ECS, attach an IAM role and leave keys empty.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Okta ───
# OKTA_ORG_URL=https://your-org.okta.com
# OKTA_API_TOKEN=

# ─── GitHub ───
# GITHUB_TOKEN=
# GITHUB_ORG=

# ─── Jira ───
# JIRA_URL=https://your.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=

# ─── SSH / Linux ───
# SSH_DEFAULT_USER=ubuntu
# SSH_KEY_PATH=/path/to/id_rsa

# ─── Azure ───
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ─── GCP ───
# GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# ─── GitLab ───
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=

# ─── Slack ───
# SLACK_BOT_TOKEN=

# ─── ServiceNow ───
# SERVICENOW_INSTANCE=dev12345
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=

# ─── Qualys ───
# QUALYS_API_URL=https://qualysapi.qualys.com
# QUALYS_USER=
# QUALYS_PASSWORD=

# ─── CrowdStrike ───
# CROWDSTRIKE_CLIENT_ID=
# CROWDSTRIKE_CLIENT_SECRET=

# ─── Scheduler (continuous assessments) ───
# ENABLE_SCHEDULER=false        # background runner; or drive POST /schedules/{id}/run via cron
# SCHEDULER_INTERVAL_SECONDS=60

# ─── Notifications (alert on new failing findings) ───
# NOTIFY_ON_STATUS=fail
# NOTIFY_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# NOTIFY_GENERIC_WEBHOOK=https://example.com/hook
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_TO=grc-team@example.com
# NOTIFY_EMAIL_FROM=comp-lens@example.com

# ─── Legacy systems (mainframe / legacy DB / SOAP / flat-file / LDAP) ───
# Named sources are configured server-side; requests reference them by name.
# Provide inline JSON or a file path (see legacy_sources.example.json):
# LEGACY_SOURCES_FILE=/etc/comp-lens/legacy_sources.json
# LEGACY_SOURCES_JSON=[{"name":"mainframe-hr","type":"sql", ...}]
