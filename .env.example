# Comp-Lens configuration — copy to .env, or just run ./install.sh to generate it.
# The installer fills POSTGRES_PASSWORD and EVIDENCE_SIGNING_KEY with random secrets.

# ═══════════════════════════════════════════════════════════════════
# DATABASE — pick ONE of the two options below
# ═══════════════════════════════════════════════════════════════════
#
# Comp-Lens holds your compliance findings, evidence and attestations. Where
# that lives is your call, and nothing phones home in either case.

# ── Option A: bundled PostgreSQL (default) ────────────────────────
# A Postgres container runs alongside the app; data sits in a Docker volume on
# this machine. Nothing else to set up — but backups, upgrades and retention
# are then yours to run (`make backup` dumps it).
POSTGRES_USER=complens
POSTGRES_PASSWORD=          # auto-generated by install.sh
POSTGRES_DB=complens

# ── Option B: your own PostgreSQL ─────────────────────────────────
# Point Comp-Lens at a database you already operate — RDS, Cloud SQL, Neon,
# Supabase, or your own server. No database container starts, and the data
# never leaves infrastructure you control, under backup and retention policy
# you already have.
#
# To use it: uncomment DATABASE_URL and COMPOSE_FILE below. The three lines
# above then do nothing and can be deleted.
#
# Paste the URL your provider gave you as-is — 'postgres://' and bare
# 'postgresql://' are both accepted and corrected at startup:
#
# DATABASE_URL=postgresql://user:password@your-host:5432/complens?sslmode=require
# COMPOSE_FILE=docker-compose.byodb.yml
#
# Notes:
#   • sslmode=require is strongly recommended for any host that is not on this
#     machine — without it credentials and evidence cross the network in clear.
#   • If your password contains @ : / or ? it must be percent-encoded
#     (@ becomes %40). A password rejected for no obvious reason is usually this.
#   • The database must exist and the user must be able to CREATE TABLE; the
#     app runs its own migrations on boot.
#   • Startup fails fast with a plain-English diagnosis if it cannot connect.
#     Check it any time without starting the app:
#         docker compose run --rm app python -m app.dbcheck
#
# How long to wait for the database at boot before giving up (seconds).
# DB_WAIT_SECONDS=60

# ═══════════════════════════════════════════════════════════════════

EVIDENCE_SIGNING_KEY=       # auto-generated by install.sh (HMAC key, 32+ hex chars)

APP_ENV=production
HOST_PORT=8000
ENABLE_SCHEDULER=false

# Evidence blobs: 'local' keeps them in a Docker volume, 's3' puts them in a
# bucket you own (set EVIDENCE_S3_BUCKET). S3 is worth it if the host running
# this container is disposable — a local volume dies with the machine.
EVIDENCE_BACKEND=local
# EVIDENCE_S3_BUCKET=

# API auth. Format: "key:tenant,key2:*" — ":*" grants every tenant.
#
# NOT optional while APP_ENV=production above: the app refuses to start with an
# empty key list, because that would make every request an all-tenant admin.
# install.sh generates one for you. To write it by hand:
#     COMP_LENS_API_KEYS=$(openssl rand -hex 32):*
# Blank is only valid when APP_ENV is local or staging.
COMP_LENS_API_KEYS=

# Optional — which connectors make live API calls. e.g. OKTA,GITHUB,AWS
LIVE_CONNECTORS_ALLOWLIST=

# Connector credentials (uncomment the ones you use)
# OKTA_ORG_URL=https://your-org.okta.com
# OKTA_API_TOKEN=
# GITHUB_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# NOTIFY_SLACK_WEBHOOK=
