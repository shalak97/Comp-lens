--- /dev/null
+++ b/app/services/privacy.py
@@ -0,0 +1,313 @@
+"""Service layer for the privacy & compliance modules."""
+from __future__ import annotations
+
+from datetime import timedelta, timezone
+from typing import Any, Dict, List, Optional
+
+from sqlalchemy import select, desc
+from sqlalchemy.orm import Session
+
+from app.privacy_models import (AuditEvent, ConsentRecord, DataSubjectRequest,
+                                ProcessingActivity, RetentionPolicy, utc_now)
+
+# Statutory response window for data-subject requests (GDPR: 1 month).
+DSAR_SLA_DAYS = 30
+
+LEGAL_BASES = ["consent", "contract", "legal_obligation", "vital_interests",
+               "public_task", "legitimate_interests"]
+DSAR_TYPES = ["access", "erasure", "rectification", "portability", "restriction", "objection"]
+
+
+# ─────────────────────────── serialisers ───────────────────────────
+def _iso(dt) -> Optional[str]:
+    return dt.isoformat() if dt else None
+
+
+def _aware(dt):
+    """SQLite returns naive datetimes; coerce to aware UTC for safe comparison."""
+    if dt is None:
+        return None
+    return dt.replace(tzinfo=timezone.utc) if dt.tzinfo is None else dt
+
+
+def consent_dict(c: ConsentRecord) -> Dict[str, Any]:
+    return {"id": c.id, "subject": c.subject, "purpose": c.purpose,
+            "categories": c.categories or {}, "granted": c.granted,
+            "version": c.version, "source": c.source, "ip": c.ip,
+            "created_at": _iso(c.created_at)}
+
+
+def dsar_dict(d: DataSubjectRequest) -> Dict[str, Any]:
+    due = _aware(d.due_at)
+    overdue = bool(due and not d.completed_at and due < utc_now())
+    days_left = None
+    if d.due_at and not d.completed_at:
+        days_left = (due - utc_now()).days
+    return {"id": d.id, "subject_email": d.subject_email, "request_type": d.request_type,
+            "status": d.status, "details": d.details, "notes": d.notes,
+            "received_at": _iso(d.received_at), "due_at": _iso(d.due_at),
+            "completed_at": _iso(d.completed_at), "overdue": overdue, "days_left": days_left}
+
+
+def ropa_dict(r: ProcessingActivity) -> Dict[str, Any]:
+    return {"id": r.id, "name": r.name, "purpose": r.purpose, "legal_basis": r.legal_basis,
+            "data_categories": r.data_categories or [], "data_subjects": r.data_subjects or [],
+            "recipients": r.recipients or [], "retention": r.retention,
+            "cross_border": r.cross_border, "safeguards": r.safeguards, "role": r.role,
+            "owner": r.owner, "updated_at": _iso(r.updated_at)}
+
+
+def retention_dict(r: RetentionPolicy) -> Dict[str, Any]:
+    return {"id": r.id, "data_category": r.data_category, "retention_days": r.retention_days,
+            "action": r.action, "basis": r.basis, "enabled": r.enabled,
+            "updated_at": _iso(r.updated_at)}
+
+
+def audit_dict(a: AuditEvent) -> Dict[str, Any]:
+    return {"id": a.id, "actor": a.actor, "action": a.action, "entity_type": a.entity_type,
+            "entity_id": a.entity_id, "summary": a.summary, "meta": a.meta or {},
+            "ip": a.ip, "created_at": _iso(a.created_at)}
+
+
+# ─────────────────────────── audit log ───────────────────────────
+def record_event(db: Session, tenant_id: str, action: str, *, actor: str = "system",
+                 entity_type: str = "", entity_id: str = "", summary: str = "",
+                 meta: Optional[dict] = None, ip: Optional[str] = None) -> AuditEvent:
+    ev = AuditEvent(tenant_id=tenant_id, actor=actor, action=action,
+                    entity_type=entity_type, entity_id=entity_id, summary=summary,
+                    meta=meta or {}, ip=ip)
+    db.add(ev)
+    db.commit()
+    return ev
+
+
+def list_events(db: Session, tenant_id: str, *, action: Optional[str] = None,
+                limit: int = 200) -> List[Dict[str, Any]]:
+    q = select(AuditEvent).where(AuditEvent.tenant_id == tenant_id)
+    if action:
+        q = q.where(AuditEvent.action == action)
+    q = q.order_by(desc(AuditEvent.created_at)).limit(limit)
+    return [audit_dict(a) for a in db.execute(q).scalars().all()]
+
+
+# ─────────────────────────── consent ledger ───────────────────────────
+def record_consent(db: Session, tenant_id: str, subject: str, categories: dict, *,
+                   purpose: str = "cookies", granted: bool = True, source: str = "banner",
+                   ip: Optional[str] = None, user_agent: Optional[str] = None) -> Dict[str, Any]:
+    c = ConsentRecord(tenant_id=tenant_id, subject=subject or "anonymous", purpose=purpose,
+                      categories=categories or {}, granted=granted, source=source,
+                      ip=ip, user_agent=user_agent)
+    db.add(c)
+    db.commit()
+    record_event(db, tenant_id, "consent.recorded", actor=subject or "anonymous",
+                 entity_type="consent", entity_id=c.id,
+                 summary=f"Consent {'granted' if granted else 'withdrawn'} for {purpose}", ip=ip)
+    return consent_dict(c)
+
+
+def list_consent(db: Session, tenant_id: str, *, subject: Optional[str] = None,
+                 limit: int = 200) -> List[Dict[str, Any]]:
+    q = select(ConsentRecord).where(ConsentRecord.tenant_id == tenant_id)
+    if subject:
+        q = q.where(ConsentRecord.subject == subject)
+    q = q.order_by(desc(ConsentRecord.created_at)).limit(limit)
+    return [consent_dict(c) for c in db.execute(q).scalars().all()]
+
+
+# ─────────────────────────── DSAR ───────────────────────────
+def create_dsar(db: Session, tenant_id: str, subject_email: str, request_type: str,
+                details: str = "", ip: Optional[str] = None) -> Dict[str, Any]:
+    if request_type not in DSAR_TYPES:
+        request_type = "access"
+    now = utc_now()
+    d = DataSubjectRequest(tenant_id=tenant_id, subject_email=subject_email,
+                           request_type=request_type, details=details, status="received",
+                           received_at=now, due_at=now + timedelta(days=DSAR_SLA_DAYS))
+    db.add(d)
+    db.commit()
+    record_event(db, tenant_id, "dsar.created", actor=subject_email or "anonymous",
+                 entity_type="dsar", entity_id=d.id,
+                 summary=f"{request_type.title()} request received", ip=ip)
+    return dsar_dict(d)
+
+
+def list_dsar(db: Session, tenant_id: str) -> List[Dict[str, Any]]:
+    q = select(DataSubjectRequest).where(DataSubjectRequest.tenant_id == tenant_id) \
+        .order_by(desc(DataSubjectRequest.received_at))
+    return [dsar_dict(d) for d in db.execute(q).scalars().all()]
+
+
+def update_dsar(db: Session, tenant_id: str, dsar_id: str, *, status: Optional[str] = None,
+                notes: Optional[str] = None) -> Optional[Dict[str, Any]]:
+    d = db.get(DataSubjectRequest, dsar_id)
+    if not d or d.tenant_id != tenant_id:
+        return None
+    if status:
+        d.status = status
+        if status in ("completed", "rejected") and not d.completed_at:
+            d.completed_at = utc_now()
+        if status not in ("completed", "rejected"):
+            d.completed_at = None
+    if notes is not None:
+        d.notes = notes
+    db.commit()
+    record_event(db, tenant_id, "dsar.updated", entity_type="dsar", entity_id=d.id,
+                 summary=f"Status → {d.status}")
+    return dsar_dict(d)
+
+
+# ─────────────────────────── ROPA ───────────────────────────
+_ROPA_DEFAULTS = [
+    {"name": "Customer account & billing", "purpose": "Operate the service and bill customers.",
+     "legal_basis": "contract", "data_categories": ["name", "email", "billing"],
+     "data_subjects": ["customers"], "recipients": ["payment processor"],
+     "retention": "Life of contract + 7 years", "role": "controller", "owner": "Finance"},
+    {"name": "Compliance evidence & findings", "purpose": "Demonstrate control compliance to auditors.",
+     "legal_basis": "legal_obligation", "data_categories": ["system metadata", "control status"],
+     "data_subjects": ["employees", "systems"], "recipients": ["external auditors"],
+     "retention": "7 years", "role": "controller", "owner": "Compliance"},
+    {"name": "Connector credentials", "purpose": "Collect evidence from connected systems.",
+     "legal_basis": "legitimate_interests", "data_categories": ["API tokens"],
+     "data_subjects": ["service accounts"], "recipients": [],
+     "retention": "Until connection removed", "role": "processor", "owner": "Security"},
+    {"name": "Website & product analytics", "purpose": "Understand product usage in aggregate.",
+     "legal_basis": "consent", "data_categories": ["usage events"], "data_subjects": ["visitors"],
+     "recipients": [], "retention": "14 months", "role": "controller", "owner": "Product"},
+]
+
+
+def ensure_seeded(db: Session, tenant_id: str) -> None:
+    """Optional: seed a starter Article-30 register + retention schedule.
+    NOT called automatically — live tables stay empty until the user adds rows."""
+    if not db.execute(select(ProcessingActivity).where(
+            ProcessingActivity.tenant_id == tenant_id).limit(1)).first():
+        for r in _ROPA_DEFAULTS:
+            db.add(ProcessingActivity(tenant_id=tenant_id, **r))
+        db.commit()
+    if not db.execute(select(RetentionPolicy).where(
+            RetentionPolicy.tenant_id == tenant_id).limit(1)).first():
+        for cat, days, act, basis in [
+            ("Connector evidence", 365, "review", "Audit evidence lifecycle"),
+            ("Audit / activity log", 730, "review", "Security & accountability"),
+            ("Consent records", 1095, "review", "Proof of consent (GDPR Art. 7)"),
+            ("DSAR records", 730, "delete", "Rights-request recordkeeping"),
+            ("Product analytics", 425, "anonymize", "Analytics minimisation"),
+        ]:
+            db.add(RetentionPolicy(tenant_id=tenant_id, data_category=cat,
+                                   retention_days=days, action=act, basis=basis))
+        db.commit()
+
+
+def create_ropa(db: Session, tenant_id: str, data: dict) -> Dict[str, Any]:
+    r = ProcessingActivity(
+        tenant_id=tenant_id, name=data.get("name", ""), purpose=data.get("purpose", ""),
+        legal_basis=data.get("legal_basis", "legitimate_interests"),
+        data_categories=data.get("data_categories", []), data_subjects=data.get("data_subjects", []),
+        recipients=data.get("recipients", []), retention=data.get("retention", ""),
+        cross_border=bool(data.get("cross_border", False)), safeguards=data.get("safeguards", ""),
+        role=data.get("role", "controller"), owner=data.get("owner", ""))
+    db.add(r)
+    db.commit()
+    record_event(db, tenant_id, "ropa.created", entity_type="ropa", entity_id=r.id,
+                 summary=f"Processing activity '{r.name}' added")
+    return ropa_dict(r)
+
+
+def list_ropa(db: Session, tenant_id: str) -> List[Dict[str, Any]]:
+    q = select(ProcessingActivity).where(ProcessingActivity.tenant_id == tenant_id) \
+        .order_by(ProcessingActivity.name)
+    return [ropa_dict(r) for r in db.execute(q).scalars().all()]
+
+
+def update_ropa(db: Session, tenant_id: str, ropa_id: str, data: dict) -> Optional[Dict[str, Any]]:
+    r = db.get(ProcessingActivity, ropa_id)
+    if not r or r.tenant_id != tenant_id:
+        return None
+    for f in ("name", "purpose", "legal_basis", "data_categories", "data_subjects",
+              "recipients", "retention", "cross_border", "safeguards", "role", "owner"):
+        if f in data:
+            setattr(r, f, data[f])
+    r.updated_at = utc_now()
+    db.commit()
+    return ropa_dict(r)
+
+
+def delete_ropa(db: Session, tenant_id: str, ropa_id: str) -> bool:
+    r = db.get(ProcessingActivity, ropa_id)
+    if not r or r.tenant_id != tenant_id:
+        return False
+    db.delete(r)
+    db.commit()
+    record_event(db, tenant_id, "ropa.deleted", entity_type="ropa", entity_id=ropa_id)
+    return True
+
+
+# ─────────────────────────── retention ───────────────────────────
+def list_retention(db: Session, tenant_id: str) -> List[Dict[str, Any]]:
+    q = select(RetentionPolicy).where(RetentionPolicy.tenant_id == tenant_id) \
+        .order_by(RetentionPolicy.data_category)
+    return [retention_dict(r) for r in db.execute(q).scalars().all()]
+
+
+def upsert_retention(db: Session, tenant_id: str, data: dict,
+                     policy_id: Optional[str] = None) -> Optional[Dict[str, Any]]:
+    r = db.get(RetentionPolicy, policy_id) if policy_id else None
+    if policy_id and (not r or r.tenant_id != tenant_id):
+        return None
+    if not r:
+        r = RetentionPolicy(tenant_id=tenant_id)
+        db.add(r)
+    for f in ("data_category", "retention_days", "action", "basis", "enabled"):
+        if f in data:
+            setattr(r, f, data[f])
+    r.updated_at = utc_now()
+    db.commit()
+    return retention_dict(r)
+
+
+def delete_retention(db: Session, tenant_id: str, policy_id: str) -> bool:
+    r = db.get(RetentionPolicy, policy_id)
+    if not r or r.tenant_id != tenant_id:
+        return False
+    db.delete(r)
+    db.commit()
+    return True
+
+
+# Map a retention category to a concrete table + timestamp column for the scan.
+def _scan_targets():
+    from app.models import ConnectorEvidenceItem, Finding  # lazy
+    return {
+        "connector evidence": (ConnectorEvidenceItem, ConnectorEvidenceItem.collected_at),
+        "audit / activity log": (AuditEvent, AuditEvent.created_at),
+        "consent records": (ConsentRecord, ConsentRecord.created_at),
+        "findings": (Finding, getattr(Finding, "detected_at", getattr(Finding, "created_at", None))),
+    }
+
+
+def scan_retention(db: Session, tenant_id: str) -> Dict[str, Any]:
+    """Evaluate each enabled policy against real rows and report how many are
+    past their retention window (the action is reported, not auto-applied)."""
+    targets = _scan_targets()
+    results, total_expired = [], 0
+    for r in db.execute(select(RetentionPolicy).where(
+            RetentionPolicy.tenant_id == tenant_id)).scalars().all():
+        cutoff = utc_now() - timedelta(days=r.retention_days)
+        key = (r.data_category or "").strip().lower()
+        target = targets.get(key)
+        expired = None
+        if target and target[1] is not None:
+            model, col = target
+            try:
+                expired = db.query(model).filter(
+                    model.tenant_id == tenant_id, col < cutoff).count()
+            except Exception:  # noqa: BLE001
+                expired = None
+        if expired:
+            total_expired += expired
+        results.append({"data_category": r.data_category, "retention_days": r.retention_days,
+                        "action": r.action, "enabled": r.enabled, "cutoff": _iso(cutoff),
+                        "expired": expired, "measurable": target is not None})
+    record_event(db, tenant_id, "retention.scanned", entity_type="retention",
+                 summary=f"Retention scan: {total_expired} record(s) past retention")
+    return {"scanned_at": _iso(utc_now()), "total_expired": total_expired, "policies": results}
