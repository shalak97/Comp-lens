+"""Privacy & compliance models: consent ledger, data-subject requests (DSAR),
+records of processing (ROPA), data-retention policies, and an immutable
+activity/audit log. All tenant-scoped, matching the project's model conventions."""
+from __future__ import annotations
+
+import uuid
+from datetime import datetime, timezone
+from typing import Optional
+
+from sqlalchemy import JSON, Boolean, DateTime, Integer, String, Text
+from sqlalchemy.orm import Mapped, mapped_column
+
+from app.database import Base
+
+
+def _uuid() -> str:
+    return str(uuid.uuid4())
+
+
+def utc_now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+class ConsentRecord(Base):
+    """An auditable, append-only record of a consent decision — the server-side
+    counterpart to the browser consent banner."""
+    __tablename__ = "consent_records"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True, default=_uuid)
+    tenant_id: Mapped[str] = mapped_column(String(128), index=True, default="default")
+    subject: Mapped[str] = mapped_column(String(256), index=True, default="")     # email / device id / user ref
+    purpose: Mapped[str] = mapped_column(String(64), default="cookies")            # cookies, marketing, processing…
+    categories: Mapped[dict] = mapped_column(JSON, default=dict)                   # {essential, preferences, analytics}
+    granted: Mapped[bool] = mapped_column(Boolean, default=True)
+    version: Mapped[int] = mapped_column(Integer, default=1)
+    source: Mapped[str] = mapped_column(String(32), default="banner")             # banner, api, dsar, import
+    ip: Mapped[Optional[str]] = mapped_column(String(64), nullable=True)
+    user_agent: Mapped[Optional[str]] = mapped_column(String(256), nullable=True)
+    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=utc_now)
+
+
+class DataSubjectRequest(Base):
+    """A GDPR/CCPA data-subject rights request with a statutory deadline."""
+    __tablename__ = "data_subject_requests"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True, default=_uuid)
+    tenant_id: Mapped[str] = mapped_column(String(128), index=True, default="default")
+    subject_email: Mapped[str] = mapped_column(String(256), index=True, default="")
+    request_type: Mapped[str] = mapped_column(String(24), default="access")        # access, erasure, rectification,
+    #                                                                                 portability, restriction, objection
+    status: Mapped[str] = mapped_column(String(24), default="received")            # received, in_progress, completed, rejected
+    details: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
+    notes: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
+    received_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=utc_now)
+    due_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True), nullable=True)
+    completed_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True), nullable=True)
+
+
+class ProcessingActivity(Base):
+    """A Records-of-Processing-Activities (GDPR Art. 30) entry."""
+    __tablename__ = "processing_activities"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True, default=_uuid)
+    tenant_id: Mapped[str] = mapped_column(String(128), index=True, default="default")
+    name: Mapped[str] = mapped_column(String(256), default="")
+    purpose: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
+    legal_basis: Mapped[str] = mapped_column(String(48), default="legitimate_interests")
+    data_categories: Mapped[list] = mapped_column(JSON, default=list)
+    data_subjects: Mapped[list] = mapped_column(JSON, default=list)
+    recipients: Mapped[list] = mapped_column(JSON, default=list)
+    retention: Mapped[str] = mapped_column(String(128), default="")
+    cross_border: Mapped[bool] = mapped_column(Boolean, default=False)
+    safeguards: Mapped[str] = mapped_column(String(256), default="")
+    role: Mapped[str] = mapped_column(String(16), default="controller")            # controller / processor
+    owner: Mapped[str] = mapped_column(String(128), default="")
+    updated_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=utc_now)
+
+
+class RetentionPolicy(Base):
+    """A data-retention rule for a category of data."""
+    __tablename__ = "retention_policies"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True, default=_uuid)
+    tenant_id: Mapped[str] = mapped_column(String(128), index=True, default="default")
+    data_category: Mapped[str] = mapped_column(String(128), index=True, default="")
+    retention_days: Mapped[int] = mapped_column(Integer, default=365)
+    action: Mapped[str] = mapped_column(String(24), default="delete")              # delete, anonymize, review
+    basis: Mapped[str] = mapped_column(String(256), default="")
+    enabled: Mapped[bool] = mapped_column(Boolean, default=True)
+    updated_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=utc_now)
+
+
+class AuditEvent(Base):
+    """Immutable activity log of meaningful actions in the platform."""
+    __tablename__ = "audit_events"
+    id: Mapped[str] = mapped_column(String(36), primary_key=True, default=_uuid)
+    tenant_id: Mapped[str] = mapped_column(String(128), index=True, default="default")
+    actor: Mapped[str] = mapped_column(String(128), default="system")
+    action: Mapped[str] = mapped_column(String(64), index=True, default="")        # e.g. consent.recorded, dsar.created
+    entity_type: Mapped[str] = mapped_column(String(64), default="")
+    entity_id: Mapped[str] = mapped_column(String(128), default="")
+    summary: Mapped[str] = mapped_column(String(256), default="")
+    meta: Mapped[dict] = mapped_column(JSON, default=dict)
+    ip: Mapped[Optional[str]] = mapped_column(String(64), nullable=True)
+    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), index=True, default=utc_now)
