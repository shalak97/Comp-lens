+    authorize_tenant(p, req.tenant_id)
+    out = _priv.upsert_retention(db, req.tenant_id, req.model_dump(exclude_unset=True), policy_id)
+    if out is None:
+        raise HTTPException(404, "unknown policy")
+    return out
+
+
+@app.delete("/privacy/retention/{policy_id}", tags=["privacy"])
+def delete_retention_ep(policy_id: str, tenant_id: str = "default", db: Session = Depends(get_db),
+                        p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, tenant_id)
+    if not _priv.delete_retention(db, tenant_id, policy_id):
+        raise HTTPException(404, "unknown policy")
+    return {"deleted": policy_id}
+
+
+@app.post("/privacy/retention/scan", tags=["privacy"])
+def scan_retention_ep(tenant_id: str = "default", db: Session = Depends(get_db),
+                      p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, tenant_id)
+    return _priv.scan_retention(db, tenant_id)
+
+
+@app.get("/privacy/audit-log", tags=["privacy"])
+def audit_log_ep(action: str | None = None, tenant_id: str = "default",
+                 db: Session = Depends(get_db), p: Principal = Depends(require_principal)) -> list[dict]:
+    authorize_tenant(p, tenant_id)
+    return _priv.list_events(db, tenant_id, action=action)
+
