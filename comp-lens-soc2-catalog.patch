+def build():
+    out = []
+    for family_id, family, items in SECTIONS:
+        # group all P-series under a single "Privacy" family for clean grouping,
+        # keep the descriptive series name in the title prefix instead
+        is_privacy = family_id.startswith("P") and family_id not in ("PI1",)
+        fam_name = PRIVACY_FAMILY if is_privacy else family
+        for cid, title, desc in items:
+            out.append({
+                "id": cid,
+                "title": title,
+                "family": fam_name,
+                "family_id": family_id,
+                "kind": "criterion",
+                "description": desc,
+            })
+    return out
