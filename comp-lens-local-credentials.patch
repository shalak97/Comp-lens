+def _ai_system_row(s) -> dict:
+    return {"id": s.id, "name": s.name, "owner": s.owner, "risk_tier": s.risk_tier,
+            "impact_assessment": s.impact_assessment, "data_governance": s.data_governance,
+            "human_oversight": s.human_oversight, "transparency_notice": s.transparency_notice,
+            "eval_report": s.eval_report, "logging_enabled": s.logging_enabled,
+            "accuracy_tested": s.accuracy_tested,
+            "registered_at": s.registered_at.isoformat() if s.registered_at else None}
+
+
+def _pets_by_system(db: Session, tenant_id: str) -> dict:
+    rows = db.execute(select(_PET).where(_PET.tenant_id == tenant_id)).scalars().all()
+    out: dict = {}
+    for r in rows:
+        out.setdefault(r.system_id, []).append(
+            {"pet": r.pet, "params": _json.loads(r.params_json or "{}"), "_sens": r.data_sensitivity})
+    return out
+
