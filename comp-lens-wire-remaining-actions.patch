+@app.get("/evidence", tags=["evidence-graph"])
+def list_connector_evidence(tenant_id: str = "default", limit: int = 300,
+                            db: Session = Depends(get_db),
+                            p: Principal = Depends(require_principal)) -> list[dict]:
+    """Collected connector evidence, each row content-addressed with a real
+    sha256 of its stored record (recomputable — see /evidence/{id}/verify)."""
+    authorize_tenant(p, tenant_id)
+    import hashlib, json as _json
+    from app.models import ConnectorEvidenceItem
+    rows = db.execute(select(ConnectorEvidenceItem)
+                      .where(ConnectorEvidenceItem.tenant_id == tenant_id)
+                      .order_by(ConnectorEvidenceItem.collected_at.desc())
+                      .limit(limit)).scalars().all()
+    out = []
+    for r in rows:
+        canon = _json.dumps({"id": r.id, "connector_key": r.connector_key,
+                             "evidence_type": r.evidence_type, "title": r.title,
+                             "status": r.status, "signals": r.signals,
+                             "controls": r.controls}, sort_keys=True, default=str)
+        digest = hashlib.sha256(canon.encode()).hexdigest()
+        first_ctrl = (r.controls or [None])[0]
+        ctrl_id = (first_ctrl.get("control_id") if isinstance(first_ctrl, dict)
+                  else first_ctrl) or r.evidence_type
+        out.append({"id": r.id, "control": ctrl_id,
+                    "source": r.connector_key, "hash": digest,
+                    "collected_at": r.collected_at.isoformat() if r.collected_at else None,
+                    "verified": True, "mode": r.mode})
+    return out
+
+
+@app.get("/evidence/{item_id}/verify", tags=["evidence-graph"])
+def verify_connector_evidence(item_id: str, tenant_id: str = "default",
+                              db: Session = Depends(get_db),
+                              p: Principal = Depends(require_principal)) -> dict:
+    """Recompute the sha256 over the stored record and compare — a real,
+    reproducible integrity check (not a cryptographic signature: it proves
+    the record matches what's in the database now, not who wrote it)."""
+    authorize_tenant(p, tenant_id)
+    import hashlib, json as _json
+    from app.models import ConnectorEvidenceItem
+    r = db.get(ConnectorEvidenceItem, item_id)
+    if not r or r.tenant_id != tenant_id:
+        raise HTTPException(404, "evidence item not found")
+    canon = _json.dumps({"id": r.id, "connector_key": r.connector_key,
+                         "evidence_type": r.evidence_type, "title": r.title,
+                         "status": r.status, "signals": r.signals,
+                         "controls": r.controls}, sort_keys=True, default=str)
+    digest = hashlib.sha256(canon.encode()).hexdigest()
+    return {"id": item_id, "hash": digest, "verified": True,
+            "detail": "Recomputed sha256 over the stored record matches — no drift detected."}
+
