# ============================================================================
# Comp-Lens — SnapDeploy (free tier) environment variables
# Paste these into SnapDeploy:  Service > Settings > Environment Variables
# (SnapDeploy injects PORT automatically — do NOT set it yourself.)
# ============================================================================

# --- Core (required) -------------------------------------------------------
APP_ENV=production

# Neon PostgreSQL connection string.
# Get it from neon.tech > your project > Connection Details.
# Neon gives you:   postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# You MUST change the prefix to  postgresql+psycopg://  for this app (psycopg3 driver).
# Keep the ?sslmode=require at the end — Neon requires SSL.
DATABASE_URL=postgresql+psycopg://USER:PASS@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Production must NOT auto-create tables — Alembic handles the schema
# (the Dockerfile runs `alembic upgrade head` on every start).
AUTO_CREATE_TABLES=false

# --- Scheduler (turn OFF on free tier) -------------------------------------
# Free containers sleep after 45 min of inactivity, so a continuous scheduler
# can't run reliably. Leave this false and trigger assessments on demand via
# the API (POST /assessments) or an external cron hitting POST /schedules/{id}/run.
# Set to true only on SnapDeploy Always-On ($12/mo) or a real VM.
ENABLE_SCHEDULER=false

# --- Evidence storage ------------------------------------------------------
# Local evidence lives on the container's disk, which is EPHEMERAL on the free
# tier — it is wiped on redeploy. Fine for demo/eval. For durable evidence use
# EVIDENCE_BACKEND=s3 (needs an AWS account).
EVIDENCE_BACKEND=local
EVIDENCE_LOCAL_PATH=/app/evidence_store

# --- API authentication (optional but recommended once public) -------------
# Format: "label:tenantA,tenantB ; label2:*"   ( * = admin, all tenants )
# Off by default (no keys) so the DEMO connector + dashboard work immediately.
# COMP_LENS_API_KEYS=admin:*

# --- CORS (set this to your dashboard origin, not * , once public) ---------
# CORS_ORIGINS=https://your-app.snapdeploy.app

# --- Connector credentials (only fill in the ones you actually use) --------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OKTA_ORG_URL=
# OKTA_API_TOKEN=
# GITHUB_TOKEN=
# JIRA_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# SSH_HOST=
# SSH_USER=
# SSH_KEY=
