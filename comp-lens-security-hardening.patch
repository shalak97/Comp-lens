+def assert_safe_url(url: str) -> None:
+    """SSRF guard for connectors that build requests from user-supplied base URLs.
+    Raises ConnectorError if the URL's host resolves to a private/loopback/
+    link-local/metadata range. Call once at connector construction on the
+    user-controlled base URL (paths appended in code are trusted)."""
+    from app.connectors.base import ConnectorError
+    host = urlparse(url).hostname or ""
+    if not host:
+        raise ConnectorError(f"invalid connector URL (no host): {url!r}")
+    if _is_blocked_host(host):
+        raise ConnectorError(
+            f"refusing connection to internal/blocked host {host!r} (SSRF protection)")
+
