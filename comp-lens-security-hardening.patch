index b6a0af1..2f68c45 100644
--- a/app/config.py
+++ b/app/config.py
@@ -10,7 +10,8 @@ import os
 from functools import lru_cache
 from typing import List, Optional
 
-from pydantic import Field
+import logging
+from pydantic import Field, field_validator, model_validator
 from pydantic_settings import BaseSettings, SettingsConfigDict
 
 
@@ -93,6 +94,42 @@ class Settings(BaseSettings):
     #   postgresql+psycopg://user:pass@host:5432/complens
     database_url: str = Field(default="sqlite:///./complens.db")
 
+    @field_validator("database_url")
+    @classmethod
+    def _normalize_database_url(cls, v: str) -> str:
+        """Pin the DB URL to a driver we actually ship.
+
+        Managed Postgres (Render/Heroku/Railway/...) hands out 'postgres://' or
+        a bare 'postgresql://' with no driver. SQLAlchemy 2.x resolves a bare
+        'postgresql://' to the psycopg2 dialect, which is NOT installed — we ship
+        psycopg v3 ('psycopg[binary]'). Without this rewrite, `alembic upgrade
+        head` and engine creation both raise ModuleNotFoundError: psycopg2 and the
+        container crash-loops on boot. Rewrite to 'postgresql+psycopg://'.
+        Already-qualified URLs (…+psycopg, …+psycopg2, sqlite, etc.) pass through.
+        """
+        if not v:
+            return v
+        if v.startswith("postgres://"):
+            v = "postgresql://" + v[len("postgres://"):]
+        if v.startswith("postgresql://"):
+            v = "postgresql+psycopg://" + v[len("postgresql://"):]
+        return v
+
+    @model_validator(mode="after")
+    def _audit_production_posture(self):
+        """Loudly flag insecure-by-omission settings in production. Non-fatal so
+        a misconfigured deploy still boots, but the warning is unmissable and the
+        auth layer fails closed independently."""
+        if self.is_production:
+            log = logging.getLogger("comp_lens.security")
+            if not os.getenv("COMP_LENS_API_KEYS", "").strip():
+                log.error("COMP_LENS_API_KEYS is unset in production — the API will refuse requests.")
+            if self.cors_origins == ["*"]:
+                log.warning("CORS_ORIGINS is '*' in production — set explicit allowed origins.")
+            if not os.getenv("COMP_LENS_SECRET_KEY", "").strip():
+                log.warning("COMP_LENS_SECRET_KEY is unset in production — connector secrets use a weak fallback key.")
+        return self
+
     # ── Evidence store ──
     # If S3 is configured, evidence goes to S3; otherwise local files.
     evidence_backend: str = Field(default="local")  # local | s3
