+def _pets_by_system(db: Session, tenant_id: str) -> dict:
+    rows = db.execute(select(_PET).where(_PET.tenant_id == tenant_id)).scalars().all()
+    out: dict = {}
+    for r in rows:
+        out.setdefault(r.system_id, []).append(
+            {"pet": r.pet, "params": _json.loads(r.params_json or "{}"), "_sens": r.data_sensitivity})
+    return out
+
