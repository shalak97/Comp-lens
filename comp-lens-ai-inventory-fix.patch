+@app.post("/connectors/assess", tags=["connectors"])
+def assess_connectors_ep(tenant_id: str = "default", db: Session = Depends(get_db),
+                         p: Principal = Depends(require_principal)) -> dict:
+    """Roll collected connector evidence up into control posture findings.
+
+    Syncing connectors fills the evidence store; this projects that evidence into
+    findings so it actually moves your compliance posture. Idempotent.
+    """
+    authorize_tenant(p, tenant_id)
+    from app.services import integration as _integ
+    return _integ.assess_connector_evidence(db, tenant_id)
+
+
+@app.get("/connectors/instances", tags=["connectors"])
+def list_instances(tenant_id: str = "default", connector_key: "str | None" = None,
+                   db: Session = Depends(get_db),
+                   p: Principal = Depends(require_principal)) -> list[dict]:
+    authorize_tenant(p, tenant_id)
+    from app.services.connector_instances import ConnectorInstanceService
+    return ConnectorInstanceService(db).list(tenant_id, connector_key)
+
+
+@app.post("/connectors/instances", tags=["connectors"])
+def create_instance(body: _InstanceCreate, db: Session = Depends(get_db),
+                    p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, body.tenant_id)
+    from app.connectors import catalog as ccat
+    if not ccat.get(body.connector_key):
+        raise HTTPException(404, f"unknown connector type '{body.connector_key}'")
+    from app.services.secrets import secrets_configured
+    if body.config and not secrets_configured() and settings.is_production:
+        raise HTTPException(400, "COMP_LENS_SECRET_KEY must be set to store connector "
+                                 "credentials in production")
+    from app.services.connector_instances import ConnectorInstanceService
+    return ConnectorInstanceService(db).create(body.tenant_id, body.connector_key,
+                                               body.label, body.config, body.enabled)
+
+
+@app.get("/connectors/instances/{instance_id}", tags=["connectors"])
+def get_instance(instance_id: str, tenant_id: str = "default",
+                 db: Session = Depends(get_db),
+                 p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, tenant_id)
+    from app.services.connector_instances import ConnectorInstanceService
+    inst = ConnectorInstanceService(db).get_public(instance_id, tenant_id)
+    if not inst:
+        raise HTTPException(404, "unknown connector instance")
+    return inst
+
+
+@app.patch("/connectors/instances/{instance_id}", tags=["connectors"])
+def update_instance(instance_id: str, body: _InstancePatch,
+                    db: Session = Depends(get_db),
+                    p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, body.tenant_id)
+    from app.services.connector_instances import ConnectorInstanceService
+    out = ConnectorInstanceService(db).update(instance_id, body.tenant_id,
+                                              label=body.label, enabled=body.enabled,
+                                              config=body.config)
+    if not out:
+        raise HTTPException(404, "unknown connector instance")
+    return out
+
+
+@app.delete("/connectors/instances/{instance_id}", tags=["connectors"])
+def delete_instance(instance_id: str, tenant_id: str = "default",
+                    db: Session = Depends(get_db),
+                    p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, tenant_id)
+    from app.services.connector_instances import ConnectorInstanceService
+    if not ConnectorInstanceService(db).delete(instance_id, tenant_id):
+        raise HTTPException(404, "unknown connector instance")
+    return {"deleted": True, "id": instance_id}
+
+
+@app.post("/connectors/instances/{instance_id}/test", tags=["connectors"])
+def test_instance_ep(instance_id: str, tenant_id: str = "default",
+                     db: Session = Depends(get_db),
+                     p: Principal = Depends(require_principal)) -> dict:
+    authorize_tenant(p, tenant_id)
+    from app.services.connector_instances import ConnectorInstanceService
+    from app.connectors import catalog as ccat, framework as cfw
+    svc = ConnectorInstanceService(db)
+    inst = svc.get(instance_id, tenant_id)
+    if not inst:
+        raise HTTPException(404, "unknown connector instance")
+    c = ccat.get(inst.connector_key)
+    if not c:
+        raise HTTPException(404, f"unknown connector type '{inst.connector_key}'")
+    return cfw.test_instance(c, svc.config_of(inst))
+
+
+@app.post("/connectors/instances/{instance_id}/sync", tags=["connectors"])
+def sync_instance_ep(instance_id: str, req: "_InstSyncRequest | None" = None,
+                     db: Session = Depends(get_db),
+                     p: Principal = Depends(require_principal)) -> dict:
+    req = req or _InstSyncRequest()
+    authorize_tenant(p, req.tenant_id)
+    from app.services.connector_instances import ConnectorInstanceService
+    from app.connectors import catalog as ccat, framework as cfw
+    svc = ConnectorInstanceService(db)
+    inst = svc.get(instance_id, req.tenant_id)
+    if not inst:
+        raise HTTPException(404, "unknown connector instance")
+    c = ccat.get(inst.connector_key)
+    if not c:
+        raise HTTPException(404, f"unknown connector type '{inst.connector_key}'")
+    res = cfw.sync_instance(db, c, instance_id, svc.config_of(inst),
+                            req.tenant_id, req.force_demo)
+    svc.record_sync(inst, status=res["status"], mode=res["mode"],
+                    evidence_count=res["evidence_count"], error=res.get("error"))
+    return res
+
+
+@app.get("/connectors/instances/{instance_id}/evidence", tags=["connectors"])
+def instance_evidence_ep(instance_id: str, tenant_id: str = "default",
