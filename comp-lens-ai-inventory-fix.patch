+# ── per-system governance posture (fuses AI-Act obligations + privacy risk) ──
+_TIER_FRAMEWORKS = {
+    "prohibited": ["EU_AI_ACT", "NIST_AI_RMF", "ISO42001"],
+    "high": ["EU_AI_ACT", "NIST_AI_RMF", "ISO42001"],
+    "limited": ["EU_AI_ACT", "ISO42001"],
+    "minimal": ["ISO42001"],
+}
+_ATTRS = ("impact_assessment", "data_governance", "human_oversight",
+          "transparency_notice", "eval_report", "logging_enabled", "accuracy_tested")
+
+
+def system_governance(system: Dict[str, Any], pets: Optional[List[Dict[str, Any]]] = None,
+                      data_sensitivity: str = "pii") -> Dict[str, Any]:
+    """One self-describing record per AI system: EU AI Act tier + obligation
+    coverage (met/gaps/%), the residual privacy risk from its PETs, and the AI
+    frameworks it is governed under. This is what the inventory should expose."""
+    attrs = {k: bool(system.get(k)) for k in _ATTRS}
+    obl = ai_act_obligations(system.get("risk_tier", "limited"), attrs)
+    applicable = [o for o in obl["obligations"] if o in obl["coverage"]]
+    tier = obl["tier"]
+    out = {
+        "id": system.get("id"), "name": system.get("name"), "owner": system.get("owner"),
+        "risk_tier": tier, "tier_label": obl["tier_label"],
+        "attributes": attrs,
+        "obligations": obl["obligations"],
+        "coverage": obl["coverage"],
+        "gaps": obl["gaps"],
+        "obligations_total": len(applicable),
+        "obligations_met": len(applicable) - len(obl["gaps"]),
+        "compliance_pct": obl["compliance_pct"],
+        "frameworks": _TIER_FRAMEWORKS.get(tier, ["ISO42001"]),
+        "registered_at": system.get("registered_at"),
+        "pets": [], "data_sensitivity": None,
+        "residual_risk": None, "residual_band": None, "privacy_explanation": None,
+        "status": ("flagged" if (tier in ("high", "prohibited") and obl["gaps"])
+                   else "approved" if obl["compliance_pct"] >= 100 else "in_review"),
+    }
+    if pets:
+        risk = compute_privacy_risk(data_sensitivity, pets)
+        out.update(residual_risk=risk["residual_risk"], residual_band=risk["residual_band"],
+                   data_sensitivity=data_sensitivity, pets=[p.get("pet") for p in pets],
+                   privacy_explanation=risk["explanation"])
+    return out
