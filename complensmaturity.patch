+"""PROOF 6: missing telemetry is reported as an affirmative control FAILURE."""
+import sys; sys.path.insert(0,"/tmp/complens")
+import os; os.environ.update({"APP_ENV":"test","EVIDENCE_SIGNING_KEY":"k",
+    "DATABASE_URL":"sqlite+pysqlite:////tmp/p6.db","ENABLE_SCHEDULER":"false"})
+from app.policy.engine import CONTROL_CATALOG
+
+EMPTY = {}          # the connector collected nothing (permission error, API change)
+na, failed, passed = [], [], []
+for cid, meta in sorted(CONTROL_CATALOG.items()):
+    status, reason = meta["evaluator"](EMPTY)
+    s = status.value if hasattr(status,"value") else str(status)
+    (na if s=="not_applicable" else failed if s=="fail" else passed).append((cid, s, reason))
+
+print(f"controls in catalog: {len(CONTROL_CATALOG)}")
+print(f"  report 'not_applicable' on missing telemetry : {len(na)}  (correct)")
+print(f"  report 'fail'           on missing telemetry : {len(failed)}  (asserts a fact never observed)")
+print()
+print("Examples of a FAIL asserted from an empty telemetry payload:")
+for cid, s, reason in failed[:8]:
+    print(f'  {cid:24} -> {s:6} "{reason}"')
+print()
+print("Compare, from the same module, the two that get it right:")
+for cid, s, reason in na[:4]:
+    print(f'  {cid:24} -> {s:14} "{reason}"')
