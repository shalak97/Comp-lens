+    client.post("/enforcement/logs", json=[_entry(would_block="true")])
+
+    status = client.get("/enforcement/status").json()
+    assert status["totals"]["requests"] == 1
+    assert status["totals"]["would_block"] == 1
+    assert status["pdp_nodes"] == 1
+
+    systems = client.get("/enforcement/systems").json()
+    assert [s["system"] for s in systems] == ["billing.internal"]
+    assert systems[0]["mode"] == "shadow"
+
+    decisions = client.get("/enforcement/decisions?limit=10").json()
+    assert decisions[0]["system"] == "billing.internal"
+    assert decisions[0]["would_block"] is True
