+"""Probe the policy expression evaluator for unhandled failure modes."""
+import sys; sys.path.insert(0,"/tmp/complens"); sys.setrecursionlimit(10000)
+from app.policy_as_code.evaluator import SafeEvaluator, PolicyExpressionError
+
+def probe(label, expr, ctx=None):
+    try:
+        r = SafeEvaluator(ctx or {}).eval(expr)
+        print(f"  {label:34} -> returned {str(r)[:40]}")
+    except PolicyExpressionError as e:
+        print(f"  {label:34} -> PolicyExpressionError: {str(e)[:50]}  (handled)")
+    except Exception as e:
+        print(f"  {label:34} -> *** {type(e).__name__}: {str(e)[:60]}  (UNHANDLED)")
+
+print("sandbox escapes:")
+for lbl, ex in [("dunder name","__import__('os')"),
+                ("dunder attr","x.__class__"),
+                ("method call","'a'.upper()"),
+                ("subscript","x[0]"),
+                ("lambda","(lambda: 1)()"),
+                ("comprehension","[i for i in range(9)]"),
+                ("walrus/assign","(x := 1)"),
+                ("fstring","f'{x}'"),
+                ("power DoS","2**999999999")]:
