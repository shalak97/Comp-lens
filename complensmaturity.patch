+"""Contrast: the EvidenceDocument path DOES use a keyed HMAC and resists the same attack."""
+import os, sys
+sys.path.insert(0, "/tmp/complens")
+for f in ("/tmp/p3b.db",):
+    if os.path.exists(f): os.remove(f)
+os.environ.update({"APP_ENV":"test","ENABLE_SCHEDULER":"false",
+    "EVIDENCE_SIGNING_KEY":"a-very-secret-key-the-attacker-does-not-have",
+    "DATABASE_URL":"sqlite+pysqlite:////tmp/p3b.db","EVIDENCE_LOCAL_PATH":"/tmp/p3b_ev"})
+from fastapi.testclient import TestClient
+from app.main import app
+import base64
+
+with TestClient(app) as c:
+    body = base64.b64encode(b"Our access control policy requires MFA for all users.").decode()
+    d = c.post("/evidence/documents", json={"tenant_id":"acme","name":"policy.txt",
+               "content":"Our access control policy requires MFA for all users.",
+               "source_type":"policy"}).json()
+    did = d.get("id") or d.get("doc_id")
+    print("document id        :", str(did)[:8])
+    print("verify before      :", c.get(f"/evidence/documents/{did}/verify?tenant_id=acme").json())
+
+    from app.database import SessionLocal
+    from app.models import EvidenceDocument
+    db = SessionLocal()
+    doc = db.get(EvidenceDocument, did)
+    doc.content_hash = "deadbeef" * 8       # tamper
+    db.commit(); db.close()
+    print(">>> verify after tamper:", c.get(f"/evidence/documents/{did}/verify?tenant_id=acme").json())
