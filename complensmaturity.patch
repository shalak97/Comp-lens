+[project]
+name = "comp-lens"
+version = "1.2.0"
+description = "Compliance-as-code and continuous control monitoring for GRC, security, audit, and AI governance teams."
+readme = "README.md"
+requires-python = ">=3.11"
+license = { file = "LICENSE" }
+authors = [{ name = "Shalak More" }]
+dynamic = ["dependencies"]
+
+[project.urls]
+Homepage = "https://github.com/shalak97/Comp-lens"
+Source = "https://github.com/shalak97/Comp-lens"
+
+[project.scripts]
+complens-policy = "cli.complens_policy:main"
+
+[tool.setuptools]
+# The app runs in place from the repository root rather than being installed as
+# a wheel, so this section exists to make `pip install -e .` work for anyone who
+# wants it — not because deployment depends on it.
+packages = ["app", "cli"]
+
+[tool.setuptools.dynamic]
+dependencies = { file = ["requirements.txt"] }
+
+# ── pytest ────────────────────────────────────────────────────────────────
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+# pythonpath replaces the PYTHONPATH=$GITHUB_WORKSPACE export CI used to need in
+# order for `import app...` to resolve when running from the repository root.
+pythonpath = ["."]
+# Test ordering is meaningful here: several modules share a database file, so a
+# randomising plugin would make the suite flaky. Pin the order explicitly rather
+# than relying on every caller remembering to pass -p no:randomly.
+addopts = "-p no:randomly --strict-markers"
+filterwarnings = [
+    "ignore::DeprecationWarning:starlette.*",
+    "ignore:Using `httpx` with `starlette.testclient` is deprecated:UserWarning",
+]
+
+# ── ruff ──────────────────────────────────────────────────────────────────
+# Consolidated here from the former standalone ruff.toml so the repository has
+# one tool-configuration file instead of two.
+[tool.ruff]
+target-version = "py311"
+line-length = 100
+indent-width = 4
+extend-exclude = [".venv", "alembic/versions", "build", "dist"]
+
+[tool.ruff.lint]
+select = ["E", "W", "F", "I", "B", "C4", "UP", "SIM"]
+ignore = ["E501", "B008"]
+
+[tool.ruff.lint.per-file-ignores]
+"__init__.py" = ["F401"]
+"tests/*" = ["B", "SIM"]
+
+[tool.ruff.lint.isort]
+known-first-party = ["app", "cli"]
+
+[tool.ruff.format]
+quote-style = "double"
+indent-style = "space"
+line-ending = "auto"
