diff --git a/tests/test_migrations.py b/tests/test_migrations.py
new file mode 100644
index 0000000..5b4c8b6
--- /dev/null
+++ b/tests/test_migrations.py
@@ -0,0 +1,89 @@
+"""The migration chain is the schema contract — hold it to the models.
+
+Successive feature migrations had drifted 68 differences away from
+`app/models.py`: three declared indexes were never created (turning every
+tenant-scoped evidence query into a full table scan) and 65 columns declared
+NOT NULL were nullable in the database. Nothing caught it, because the test
+suite builds its schema with `Base.metadata.create_all()` and therefore never
+executes a migration.
+
+This test builds a database the way production does — `alembic upgrade head` on
+an empty file — and asserts autogenerate finds nothing left to do.
+"""
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from alembic.autogenerate import compare_metadata
+from alembic.migration import MigrationContext
+from sqlalchemy import create_engine, inspect
+
+import app.models  # noqa: F401 — registers every table on Base.metadata
+from app.database import Base
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def _migrated_db(tmp_path: Path, *args: str) -> str:
+    """Run `alembic <args>` against a throwaway SQLite file; return its URL."""
+    url = f"sqlite+pysqlite:///{tmp_path / 'migrated.db'}"
+    proc = subprocess.run(  # noqa: S603
+        [sys.executable, "-m", "alembic", *args],
+        cwd=REPO_ROOT,
+        env={"PATH": "/usr/bin:/bin", "DATABASE_URL": url, "APP_ENV": "test",
+             "ENABLE_SCHEDULER": "false", "EVIDENCE_SIGNING_KEY": "test-signing-key",
+             "PYTHONPATH": str(REPO_ROOT)},
+        capture_output=True, text=True,
+    )
+    if proc.returncode != 0:
+        pytest.fail(f"alembic {' '.join(args)} failed:\n{proc.stdout}\n{proc.stderr}")
+    return url
+
+
+def test_migrations_produce_the_schema_the_models_declare(tmp_path):
+    url = _migrated_db(tmp_path, "upgrade", "head")
+    engine = create_engine(url)
+    try:
+        with engine.connect() as conn:
+            diff = compare_metadata(MigrationContext.configure(conn), Base.metadata)
+    finally:
+        engine.dispose()
+
+    assert diff == [], (
+        "The migration chain no longer matches app/models.py. Run\n"
+        "  alembic revision --autogenerate -m '<what changed>'\n"
+        "and commit the result. Pending differences:\n  "
+        + "\n  ".join(str(d) for d in diff)
+    )
+
+
+def test_tenant_scoped_evidence_lookups_are_indexed(tmp_path):
+    """Guard the specific indexes whose absence caused full table scans."""
+    url = _migrated_db(tmp_path, "upgrade", "head")
+    engine = create_engine(url)
+    try:
+        insp = inspect(engine)
+        for table, column in (("evidence_documents", "tenant_id"),
+                              ("evidence_concept_hits", "tenant_id"),
+                              ("evidence_concept_hits", "doc_id")):
+            indexed = {c for ix in insp.get_indexes(table) for c in ix["column_names"]}
+            assert column in indexed, f"{table}.{column} is not indexed"
+    finally:
+        engine.dispose()
+
+
+def test_migration_chain_has_exactly_one_head(tmp_path):
+    """Two heads mean `alembic upgrade head` is ambiguous and deploys break."""
+    proc = subprocess.run(  # noqa: S603
+        [sys.executable, "-m", "alembic", "heads"],
+        cwd=REPO_ROOT,
+        env={"PATH": "/usr/bin:/bin", "DATABASE_URL": f"sqlite+pysqlite:///{tmp_path / 'h.db'}",
+             "APP_ENV": "test", "ENABLE_SCHEDULER": "false",
+             "EVIDENCE_SIGNING_KEY": "test-signing-key", "PYTHONPATH": str(REPO_ROOT)},
+        capture_output=True, text=True, check=True,
+    )
+    heads = [ln for ln in proc.stdout.splitlines() if ln.strip()]
+    assert len(heads) == 1, f"expected a single head, found:\n{proc.stdout}"
