+"""PROOF 1: POST /policies/import reports success but silently discards the policy."""
+import os, sys
+sys.path.insert(0, "/tmp/complens")
+os.environ.update({"APP_ENV":"test","ENABLE_SCHEDULER":"false","EVIDENCE_SIGNING_KEY":"k",
+                   "DATABASE_URL":"sqlite+pysqlite:////tmp/p1.db"})
+from fastapi.testclient import TestClient
+from app.main import app
+
+POLICY = """
+control: PROOF-1
+title: Proof policy
+severity: critical
+frameworks:
+  NIST: [PROOF-1]
+pass_when: "proof == true"
+"""
+
+with TestClient(app) as c:
+    before = {p["control_id"] for p in c.get("/policies").json()}
+    r = c.post("/policies/import", json={"tenant_id":"default","name":"proof","yaml":POLICY})
+    print("import HTTP     :", r.status_code)
+    print("import response :", r.json())
+    after = {p["control_id"] for p in c.get("/policies").json()}
+    print("policies before :", sorted(before))
+    print("policies after  :", sorted(after))
+    print()
+    print(">>> API reported imported=True for control_id=PROOF-1")
+    print(">>> PROOF-1 present in engine afterwards? ", "PROOF-1" in after)
+    ev = c.post("/v1/policy/evaluate", json={"control":"PROOF-1","evidence":{"proof":True}})
+    print(">>> evaluate PROOF-1 ->", ev.status_code, str(ev.json())[:140])
