+"""Enforcement control plane: bundle serving + decision-log ingestion.
+
+These two routes previously lived in a standalone `app/app.py` that nothing
+imported, ran, or tested — and its bundle builder raised FileNotFoundError
+whenever the policy directory was unpopulated. They now live in `app.main` on
+top of `app.services.enforcement`, so they are covered here alongside the read
+views that were already wired up.
+"""
+from __future__ import annotations
+
+import gzip
+import io
+import json
+import tarfile
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app.main import app
+from app.services import enforcement as enf
+
+
+@pytest.fixture()
+def client():
+    with TestClient(app) as c:
+        yield c
+
+
+@pytest.fixture()
+def bundle_dir(tmp_path, monkeypatch):
+    """Point the control plane at a throwaway, fully populated bundle."""
+    (tmp_path / "main.rego").write_text("package envoy.authz\n\ndefault allow := true\n")
+    (tmp_path / "data.json").write_text(json.dumps(
+        {"systems": {"billing.internal": {"mode": "shadow", "fail": "open",
+                                          "policy_id": "p-1", "allowed_roles": ["sre"]}}}))
+    monkeypatch.setattr(enf, "POLICY_DIR", tmp_path)
+    return tmp_path
+
+
+@pytest.fixture(autouse=True)
+def _reset_counters():
+    yield
+    enf.DECISIONS.clear()
+    enf.PEPS.clear()
+    enf.SYS_COUNTERS.clear()
+
+
+# ── bundle ────────────────────────────────────────────────────────────────
+def test_bundle_is_a_valid_tarball_carrying_its_own_revision(client, bundle_dir):
+    r = client.get("/enforcement/bundles/complens.tar.gz")
+    assert r.status_code == 200
+    assert r.headers["content-type"] == "application/gzip"
+
+    rev = r.headers["X-Bundle-Revision"]
+    assert r.headers["ETag"] == rev
+
+    with tarfile.open(fileobj=io.BytesIO(r.content), mode="r:gz") as tar:
+        assert sorted(tar.getnames()) == [".manifest", "data.json", "main.rego"]
+        manifest = json.loads(tar.extractfile(".manifest").read())
+    # The manifest revision must match the header, or a PDP cannot tell which
+    # bundle produced a given decision.
+    assert manifest["revision"] == rev
+
+
+def test_bundle_revision_changes_when_policy_changes(client, bundle_dir):
+    first = client.get("/enforcement/bundles/complens.tar.gz").headers["X-Bundle-Revision"]
+    (bundle_dir / "main.rego").write_text("package envoy.authz\n\ndefault allow := false\n")
+    second = client.get("/enforcement/bundles/complens.tar.gz").headers["X-Bundle-Revision"]
+    assert first != second
+
+
+def test_unprovisioned_bundle_is_503_not_a_traceback(client, tmp_path, monkeypatch):
+    monkeypatch.setattr(enf, "POLICY_DIR", tmp_path / "does-not-exist")
+    r = client.get("/enforcement/bundles/complens.tar.gz")
+    assert r.status_code == 503
+    assert "main.rego" in r.text
+    # The read views must stay up even with no bundle deployed.
+    assert client.get("/enforcement/status").json()["bundle_revision"] == "unversioned"
+
+
+# ── decision logs ─────────────────────────────────────────────────────────
+def _entry(system="billing.internal", would_block="false", allowed=True):
+    return {
+        "decision_id": "d-1",
+        "path": "envoy/authz/allow",
+        "labels": {"system": "pdp-a"},
+        "bundles": {"complens": {"revision": "abc123"}},
+        "input": {"attributes": {"request": {"http": {"method": "GET", "path": "/x"}}}},
+        "result": {
+            "allowed": allowed,
+            "headers": {
+                "x-complens-system": system,
+                "x-complens-mode": "shadow",
+                "x-complens-would-block": would_block,
+            },
+        },
+    }
+
+
+def test_plain_json_decision_log_is_ingested(client):
+    r = client.post("/enforcement/logs", json=[_entry(), _entry(would_block="true")])
+    assert r.status_code == 200
+    assert r.json() == {"received": 2, "ingested": 2}
+
+    counters = enf.SYS_COUNTERS["billing.internal"]
+    assert counters["requests"] == 2
+    assert counters["would_block"] == 1
+
+
+def test_gzipped_decision_log_is_ingested(client):
+    body = gzip.compress(json.dumps([_entry()]).encode())
+    r = client.post("/enforcement/logs", content=body,
+                    headers={"Content-Encoding": "gzip", "Content-Type": "application/json"})
+    assert r.json() == {"received": 1, "ingested": 1}
+
+
+def test_unrelated_and_malformed_entries_are_skipped_not_fatal(client):
+    payload = [
+        _entry(),
+        {"path": "system/health"},          # not an authz decision
+        {"path": "envoy/authz/allow", "result": "not-a-dict"},
+        "a bare string",                     # not even an object
+    ]
+    r = client.post("/enforcement/logs", json=payload)
+    # One bad entry must never cost us the whole batch.
+    assert r.json() == {"received": 4, "ingested": 1}
+
+
+def test_invalid_payloads_are_400(client):
+    assert client.post("/enforcement/logs", content=b"{not json",
+                       headers={"Content-Type": "application/json"}).status_code == 400
+    assert client.post("/enforcement/logs", content=b"\x1f\x8b not really gzip",
+                       headers={"Content-Encoding": "gzip"}).status_code == 400
