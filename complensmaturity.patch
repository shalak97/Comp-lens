+"""PROOF 5: one failing schedule rolls back every schedule that already succeeded."""
+import os, sys
+sys.path.insert(0,"/tmp/complens")
+for f in ("/tmp/p5.db",):
+    if os.path.exists(f): os.remove(f)
+os.environ.update({"APP_ENV":"test","ENABLE_SCHEDULER":"false","EVIDENCE_SIGNING_KEY":"k",
+    "DATABASE_URL":"sqlite+pysqlite:////tmp/p5.db","EVIDENCE_LOCAL_PATH":"/tmp/p5_ev"})
+from fastapi.testclient import TestClient
+from app.main import app
+from datetime import datetime, UTC, timedelta
+
+with TestClient(app) as c:
+    # three schedules, all already due
+    ids = []
+    for n in ("s1","s2","s3"):
+        r = c.post("/schedules", json={"tenant_id":"acme","name":n,"interval_minutes":60,
+                   "controls":[{"control_id":"AC-2-7","source_system":"DEMO"}]})
+        ids.append(r.json()["schedule_id"])
+    from app.database import SessionLocal
+    from app.models import Schedule
+    db = SessionLocal()
+    past = datetime.now(UTC) - timedelta(hours=2)
+    for s in db.query(Schedule).all(): s.next_run_at = past
+    db.commit(); db.close()
+    print("schedules due      :", len(ids))
+
+    # Fault-injection: make the 2nd schedule's post-run snapshot fail, exactly as a
+    # transient DB/serialisation error would.
+    from app.services import scheduler as sched
+    from app.services.trends import TrendService
+    calls = {"n":0}
+    real = TrendService.snapshot
+    def flaky(self, tenant_id, summary):
+        calls["n"] += 1
+        if calls["n"] == 2:
+            raise RuntimeError("transient failure during snapshot")
+        return real(self, tenant_id, summary)
+    TrendService.snapshot = flaky
+
+    ran = sched.ScheduleService.run_due()
+    print("run_due returned   :", ran)
+
+    db = SessionLocal()
+    rows = db.query(Schedule).order_by(Schedule.name).all()
+    for s in rows:
+        print(f"  {s.name}: last_run_at={s.last_run_at}  (None = looks like it never ran)")
+    from app.models import Finding
+    print("findings persisted :", db.query(Finding).count())
+    db.close()
+    import glob
+    print("evidence files on disk:", len(glob.glob("/tmp/p5_ev/**/*", recursive=True)))
+    print()
+    print(">>> schedule s1 completed successfully but its run was rolled back")
+    print(">>> evidence artifacts it wrote to disk were NOT rolled back -> orphans")
+
+    # Does the rollback cause repeated re-runs that accumulate duplicates?
+    print()
+    print("--- simulating three more scheduler ticks with the same transient fault ---")
+    for tick in range(3):
+        sched.ScheduleService.run_due()
+        db = SessionLocal()
+        from app.models import Finding as F, EvidenceMeta as E
+        print(f"  after tick {tick+2}: findings={db.query(F).count()}  evidence_rows={db.query(E).count()}")
+        db.close()
+    print(">>> the same schedules re-run every tick and duplicate evidence accumulates")
