diff --git a/tests/test_integration_hardening.py b/tests/test_integration_hardening.py
new file mode 100644
index 0000000..4d63660
--- /dev/null
+++ b/tests/test_integration_hardening.py
@@ -0,0 +1,154 @@
+"""Regression tests for the audit hardening fixes in app/services/integration.py.
+
+These are DB-free: they patch the service/threat dependencies so each fix is
+asserted in isolation.
+
+  R1  escalate_risks_from_threat is idempotent (no cumulative impact inflation)
+  R2  run_unified_pipeline is fault-isolated (one flow failing doesn't abort/partial)
+  R4  ai-risk dedup keys on system_id marker, not a title suffix (no collisions)
+"""
+import sys
+from types import SimpleNamespace
+
+import app.services.integration as integ
+from app.grc_tprm_models import RiskPatch
+
+
+# ----------------------------------------------------------------------------
+# R1 — idempotent threat escalation
+# ----------------------------------------------------------------------------
+class _FakeRiskSvc:
+    """Minimal in-memory RiskService; shared store survives across instances."""
+    store = []
+
+    def __init__(self, db=None):
+        pass
+
+    def list(self, tenant_id):
+        # return copies, like real serialization, so callers can't mutate the store directly
+        return [dict(r) for r in self.store]
+
+    def update(self, tenant_id, risk_id, patch: RiskPatch):
+        for r in self.store:
+            if r["id"] == risk_id:
+                if patch.impact is not None:
+                    r["impact"] = patch.impact
+                if patch.description is not None:
+                    r["description"] = patch.description
+                return dict(r)
+        return None
+
+
+def _patch_threat(monkeypatch, active=2):
+    import app.services.threat_intel as ti
+    monkeypatch.setattr(ti, "threat_pressure",
+                        lambda: {"actively_exploited": active,
+                                 "exploitation_pressure": "high"})
+
+
+def _patch_risksvc(monkeypatch, store):
+    import app.services.grc_tprm as grc
+    _FakeRiskSvc.store = store
+    monkeypatch.setattr(grc, "RiskService", _FakeRiskSvc)
+
+
+def test_R1_escalation_is_idempotent(monkeypatch):
+    _patch_threat(monkeypatch, active=2)
+    store = [{"id": "r1", "linked_control": "RA-5", "impact": 3,
+              "description": "", "category": "vuln"}]
+    _patch_risksvc(monkeypatch, store)
+
+    first = integ.escalate_risks_from_threat(db=None, tenant_id="t")
+    assert first["escalated"] == 1
+    assert store[0]["impact"] == 4                      # raised once
+    assert "[kev-escalated]" in store[0]["description"]  # durable marker set
+
+    # Re-running the pipeline must NOT keep ratcheting impact upward.
+    second = integ.escalate_risks_from_threat(db=None, tenant_id="t")
+    assert second["escalated"] == 0
+    assert store[0]["impact"] == 4                      # unchanged on second run
+
+    third = integ.escalate_risks_from_threat(db=None, tenant_id="t")
+    assert store[0]["impact"] == 4                      # still 4, never 5/6/...
+
+
+def test_R1_caps_at_five_and_skips_non_vuln(monkeypatch):
+    _patch_threat(monkeypatch, active=1)
+    store = [
+        {"id": "hi", "linked_control": "SI-2", "impact": 5, "description": "", "category": "v"},  # already max
+        {"id": "nv", "linked_control": "AC-2", "impact": 3, "description": "", "category": "x"},  # not a vuln control
+    ]
+    _patch_risksvc(monkeypatch, store)
+    res = integ.escalate_risks_from_threat(db=None, tenant_id="t")
+    assert res["escalated"] == 0
+    assert store[0]["impact"] == 5 and store[1]["impact"] == 3
+
+
+# ----------------------------------------------------------------------------
+# R2 — fault-isolated orchestrator
+# ----------------------------------------------------------------------------
+class _FakeDB:
+    def __init__(self):
+        self.rollbacks = 0
+
+    def rollback(self):
+        self.rollbacks += 1
+
+
+def test_R2_pipeline_isolates_failures(monkeypatch):
+    monkeypatch.setattr(integ, "evaluate_policies_to_findings",
+                        lambda db, t, ev: {"findings_created": 1})
+
+    def boom(db, t):
+        raise RuntimeError("ai-gov exploded")
+    monkeypatch.setattr(integ, "sync_all_ai_risks", boom)
+    monkeypatch.setattr(integ, "escalate_risks_from_threat",
+                        lambda db, t: {"escalated": 0})
+
+    db = _FakeDB()
+    out = integ.run_unified_pipeline(db, "t", evidence_by_control={"AC-2-7": {}})
+
+    # the failing flow is reported, not raised...
+    assert "ai_to_risk" in out["errors"]
+    assert "RuntimeError" in out["errors"]["ai_to_risk"]
+    assert out["ok"] is False
+    # ...its uncommitted work was rolled back...
+    assert db.rollbacks == 1
+    # ...and the flows on either side still ran and kept their results.
+    assert out["results"]["policy_to_findings"]["findings_created"] == 1
+    assert out["results"]["threat_escalation"]["escalated"] == 0
+
+
+def test_R2_all_succeed_no_errors(monkeypatch):
+    monkeypatch.setattr(integ, "evaluate_policies_to_findings", lambda db, t, ev: {"ok": 1})
+    monkeypatch.setattr(integ, "sync_all_ai_risks", lambda db, t: {"ok": 1})
+    monkeypatch.setattr(integ, "escalate_risks_from_threat", lambda db, t: {"ok": 1})
+    db = _FakeDB()
+    out = integ.run_unified_pipeline(db, "t", evidence_by_control={"X": {}})
+    assert out["ok"] is True and out["errors"] == {} and db.rollbacks == 0
+
+
+# ----------------------------------------------------------------------------
+# R4 — dedup keys on system_id marker, not a title suffix
+# ----------------------------------------------------------------------------
+def test_R4_dedup_marker_is_collision_free():
+    link_a = integ._ai_link("sys-AAA")
+    link_b = integ._ai_link("sys-BBB")
+    assert link_a != link_b
+
+    # Two systems whose NAMES collide under the old endswith() check:
+    #   "Model A"  vs  "Premium Model A"  -> title.endswith("Model A") true for both.
+    # The marker dedup must treat them as distinct.
+    risks = [
+        {"category": integ.AIGOV_CATEGORY, "title": "AI privacy risk: Premium Model A",
+         "description": f"... {integ._ai_link('sys-AAA')}"},
+    ]
+    # querying for system BBB must NOT match the Premium-Model-A risk
+    matches_bbb = [r for r in risks
+                   if r.get("category") == integ.AIGOV_CATEGORY
+                   and integ._ai_link("sys-BBB") in (r.get("description") or "")]
+    assert matches_bbb == []
+    # querying for AAA matches exactly
+    matches_aaa = [r for r in risks
+                   if integ._ai_link("sys-AAA") in (r.get("description") or "")]
+    assert len(matches_aaa) == 1
