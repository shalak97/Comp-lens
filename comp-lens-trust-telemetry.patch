+@app.get("/middleware/pipeline-stats", tags=["evidence-graph"])
+def middleware_pipeline_stats(tenant_id: str = "default", db: Session = Depends(get_db),
+                              p: Principal = Depends(require_principal)) -> dict:
+    """Real counts for the evidence pipeline, computed from actual rows —
+    not a latency/throughput simulator. Fields we can't honestly measure yet
+    (request-level latency percentiles) are reported as null, not invented."""
+    authorize_tenant(p, tenant_id)
+    from datetime import datetime, timedelta, timezone
+    from app.models import ConnectorEvidenceItem, Finding
+    cutoff = datetime.now(timezone.utc) - timedelta(hours=24)
+    collected_24h = db.query(ConnectorEvidenceItem).filter(
+        ConnectorEvidenceItem.tenant_id == tenant_id,
+        ConnectorEvidenceItem.collected_at >= cutoff).count()
+    findings_24h = db.query(Finding).filter(
+        Finding.tenant_id == tenant_id, Finding.created_at >= cutoff).count()
+    evidence_total = db.query(ConnectorEvidenceItem).filter(
+        ConnectorEvidenceItem.tenant_id == tenant_id).count()
+    return {
+        "window": "24h", "collected": collected_24h, "findings": findings_24h,
+        "evidence_addressable": evidence_total,
+        "integrity_note": "Each evidence item is content-addressed (sha256, recomputable "
+                          "via GET /evidence/{id}/verify) — this confirms the stored record "
+                          "hasn't drifted, not a cryptographic signature of authorship.",
+        "latency_p50_s": None, "latency_p95_s": None, "queue_depth": None,
+        "latency_note": "Request-level pipeline latency isn't instrumented yet.",
+    }
